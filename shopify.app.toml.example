# Shopify App Configuration
# Learn more at https://shopify.dev/docs/apps/tools/cli/configuration
#
# To use this file:
# 1. Copy to shopify.app.toml: cp shopify.app.toml.example shopify.app.toml
# 2. Replace "your_shopify_app_client_id" with your actual client ID from Shopify Partner Dashboard
# 3. Update application_url and redirect_urls for your environment
# 4. Deploy with: shopify app deploy

client_id = "your_shopify_app_client_id"
name = "notipus"
application_url = "https://app.notipus.com"
embedded = false

[webhooks]
# Keep in sync with SHOPIFY_API_VERSION in the Django settings.
api_version = "2026-07"

# Mandatory for every public app. Shopify rejects a submission that does
# not provide these, or that does not answer them correctly - note it
# requires 401 (not 400) when the HMAC is invalid.
[webhooks.privacy_compliance]
customer_data_request_url = "https://app.notipus.com/webhook/shopify/compliance/customers/data-request/"
customer_deletion_url = "https://app.notipus.com/webhook/shopify/compliance/customers/redact/"
shop_deletion_url = "https://app.notipus.com/webhook/shopify/compliance/shop/redact/"

# Not mandatory, but without it an uninstall leaves the integration
# marked active for a store that no longer sends anything.
[[webhooks.subscriptions]]
topics = ["app/uninstalled"]
uri = "https://app.notipus.com/webhook/shopify/app/uninstalled/"

# Event subscriptions are declared here rather than created per shop
# through the Admin API. That is deliberate: declaring them means
# Notipus never needs an access token, so it holds no standing ability
# to read a merchant's orders or customers.
#
# The trade-off is that every installed store sends every topic listed
# here. Which of them a workspace actually wants is decided on receipt,
# from the categories chosen on the integration page - see
# _topic_is_enabled in app/webhooks/webhook_router.py.
[[webhooks.subscriptions]]
topics = [
  "orders/create",
  "orders/paid",
  "orders/cancelled",
  "orders/fulfilled",
  "refunds/create",
  "fulfillments/create",
  "fulfillments/update",
  "customers/update",
]
uri = "https://app.notipus.com/webhook/shopify/events/"

# Subscription topics are deliberately NOT declared.
#
# They need read_own_subscription_contracts, which Shopify gates behind
# an access request - and which grants the SubscriptionContract object
# only "for records that belong to your app". Notipus creates no
# contracts: merchants run subscriptions through Recharge, Shopify
# Subscriptions and the like. So the scope would cover nothing we care
# about, and Shopify documents no scope for reading another app's
# contracts.
#
# The parser handles these payloads (see plugins/sources/shopify.py) so
# the capability is there if Notipus ever owns contracts, but declaring
# the topics now would only add subscriptions nothing can deliver.
#
# Recurring revenue is instead visible through the order stream, which
# needs no extra scope: a subscription charge produces an ordinary
# order.

[access_scopes]
# The minimum needed to receive the declared topics:
# - read_orders: order and refund events
# - read_customers: customer events
# - read_fulfillments: fulfillments/create and fulfillments/update.
#   Shopify rejects the deploy without it ("read_fulfillments or
#   read_marketplace_orders"); read_orders alone is not enough.
#
# These grant the right to *receive* those webhooks. Notipus does not
# keep the resulting access token, so it cannot read anything from the
# store beyond the events Shopify pushes to it.
#
# Note: There is no "write_webhooks" scope in Shopify. Permission to
# subscribe comes from holding the matching read scope for the resource.
scopes = "read_orders,read_customers,read_fulfillments"
optional_scopes = []
use_legacy_install_flow = false

[auth]
# OAuth callback URL - must match SHOPIFY_REDIRECT_URI environment variable
redirect_urls = ["https://app.notipus.com/api/connect/shopify/callback/"]
