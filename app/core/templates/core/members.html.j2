{% extends "core/base.html.j2" %}

{% block title %}
    Members - {{ workspace.name }}
{% endblock title %}

{% block content %}
    <c-page width="default"
            back="{% url 'core:dashboard' %}"
            back_label="Dashboard"
            title="Members"
            subtitle="Everyone who can see this workspace and change its integrations.">
        <c-slot name="actions">
            {% if remaining_seats > 0 %}
                <c-badge tone="success" dot>
                    {{ remaining_seats }} seat{{ remaining_seats|pluralize }} left
                </c-badge>
            {% else %}
                <c-badge tone="warning" dot>
                    No seats left
                </c-badge>
            {% endif %}
        </c-slot>

        {% if can_invite %}
            <c-card title="Invite someone"
                    description="They get an email with a link that expires in seven days."
                    icon="user-plus">
                <c-form action="{% url 'core:invite_member' %}">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
                        <c-input name="email"
                                 type="email"
                                 label="Email address"
                                 placeholder="colleague@company.com"
                                 required
                                 class="flex-1" />
                        <c-select name="role" label="Role" class="sm:w-44">
                            <option value="user">Member</option>
                            <option value="admin">Admin</option>
                            {% if current_member.role == "owner" %}<option value="owner">Owner</option>{% endif %}
                        </c-select>
                        <c-button type="submit" icon="send">
                            Send invitation
                        </c-button>
                    </div>
                </c-form>
            </c-card>
        {% else %}
            <c-alert tone="warning" title="You've used every seat on this plan">
                {{ invite_message }}
                <c-slot name="actions">
                    <c-button href="{% url 'core:upgrade_plan' %}" size="sm">Upgrade plan</c-button>
                </c-slot>
            </c-alert>
        {% endif %}

        <c-card title="Members"
                description="{{ members|length }} member{{ members|length|pluralize }}"
                icon="users"
                flush>
            <c-list>
                {% for member in members %}
                    <c-list.row title="{{ member.user.get_full_name|default:member.user.email }}{% if member.id == current_member.id %} (you){% endif %}"
                                :description="member.user.email">
                        <c-slot name="leading">
                            <c-avatar :name="member.user.email" />
                        </c-slot>
                        <c-slot name="actions">
                            {% if member.id == current_member.id or not member.can_manage %}
                                <c-badge tone="{% if member.role == 'owner' %}brand{% elif member.role == 'admin' %}info{% else %}neutral{% endif %}">
                                    {{ member.role|title }}
                                </c-badge>
                            {% endif %}

                            {% if member.id != current_member.id %}
                                {% if current_member.role == "owner" or current_member.role == "admin" and member.role != "owner" %}
                                    <form method="post"
                                          action="{% url 'core:change_role' member.id %}"
                                          class="flex items-center">
                                        {% csrf_token %}
                                        <label for="role-{{ member.id }}" class="sr-only">Role for {{ member.user.email }}</label>
                                        <select name="role"
                                                id="role-{{ member.id }}"
                                                onchange="this.form.submit()"
                                                class="rounded-control border border-border-control bg-surface px-2 py-1 text-caption text-content focus:outline-none focus:ring-2 focus:ring-focus focus:ring-offset-1">
                                            <option value="user" {% if member.role == "user" %}selected{% endif %}>Member</option>
                                            <option value="admin" {% if member.role == "admin" %}selected{% endif %}>Admin</option>
                                            {% if current_member.role == "owner" %}
                                                <option value="owner" {% if member.role == "owner" %}selected{% endif %}>Owner</option>
                                            {% endif %}
                                        </select>
                                    </form>

                                    <form method="post"
                                          action="{% url 'core:remove_member' member.id %}"
                                          onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Remove {{ member.user.email|escapejs }}?', message: 'They lose access to this workspace immediately. You can invite them again later.', variant: 'danger', confirmText: 'Remove'})">
                                        {% csrf_token %}
                                        <c-button type="submit" variant="link-danger">
                                            Remove
                                        </c-button>
                                    </form>
                                {% endif %}
                            {% endif %}
                        </c-slot>
                    </c-list.row>
                {% empty %}
                    <li>
                        <c-empty-state icon="users"
                                       title="No members yet"
                                       description="Invite the people who need to see these notifications." />
                    </li>
                {% endfor %}
            </c-list>
        </c-card>

        {% if pending_invitations %}
            <c-card title="Pending invitations"
                    description="{{ pending_invitations|length }} waiting to be accepted"
                    icon="mail-forward"
                    flush>
                <c-list>
                    {% for invitation in pending_invitations %}
                        <c-list.row :title="invitation.email"
                                    description="Invited {{ invitation.created_at|timesince }} ago by {{ invitation.invited_by.email }}"
                                    icon="mail">
                            <c-slot name="actions">
                                <c-badge tone="warning">
                                    {{ invitation.role|title }}
                                </c-badge>
                                <form method="post"
                                      action="{% url 'core:cancel_invitation' invitation.id %}"
                                      onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Cancel this invitation?', message: 'The link in {{ invitation.email|escapejs }}\'s email stops working.', variant: 'danger', confirmText: 'Cancel invitation', cancelText: 'Keep it'})">
                                    {% csrf_token %}
                                    <c-button type="submit" variant="link-muted">
                                        Cancel
                                    </c-button>
                                </form>
                            </c-slot>
                        </c-list.row>
                    {% endfor %}
                </c-list>
            </c-card>
        {% endif %}
    </c-page>
{% endblock content %}
