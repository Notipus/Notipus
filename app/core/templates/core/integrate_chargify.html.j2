{% extends "core/base.html.j2" %}

{% block title %}
    Connect Chargify - Notipus
{% endblock title %}

{% block content %}
    <c-page back="{% url 'core:integrations' %}"
            back_label="Integrations"
            title="Connect Chargify"
            subtitle="Subscription and billing events from Chargify, also sold as Maxio Advanced Billing.">
        {% if existing_integration and existing_integration.is_webhook_verified %}
            <c-alert tone="success" title="Chargify is connected">
                Events are arriving. Paste a new secret below if you ever change it.
            </c-alert>
        {% elif existing_integration %}
            <c-alert tone="warning" title="Waiting for the first event">
                Your webhook secret is saved. Send a test webhook from Chargify and this turns green.
            </c-alert>
        {% endif %}

        <c-card title="Set up the webhook"
                description="Four steps in the Chargify dashboard, under Settings → Webhooks."
                icon="list-numbers">
            <c-form>
                <c-checklist>
                    <c-checklist.item index="1"
                                      title="Open Settings → Webhooks"
                                      description="In Chargify, or in Maxio Advanced Billing at the same place." />
                    <c-checklist.item index="2" title="Add this endpoint URL">
                        <c-code-block value="{{ webhook_url }}" class="mt-3" />
                    </c-checklist.item>
                    <c-checklist.item index="3" title="Copy the webhook secret back here">
                        <div class="mt-3">
                            <c-input name="webhook_secret"
                                     label="Webhook secret"
                                     placeholder="Paste the secret from Chargify"
                                     help="We store this encrypted and use it to verify every incoming webhook."
                                     secret
                                     required />
                        </div>
                    </c-checklist.item>
                    <c-checklist.item index="4"
                                      title="Send a test webhook"
                                      description="Chargify's test button is enough to confirm the connection." />
                </c-checklist>

                <c-slot name="actions">
                    <c-button type="submit" icon="plug-connected">
                        {% if existing_integration %}
                            Update Chargify
                        {% else %}
                            Connect Chargify
                        {% endif %}
                    </c-button>
                </c-slot>
            </c-form>
        </c-card>

        <c-card title="Not the person with Chargify access?"
                description="Send these steps to whoever manages your billing account."
                icon="mail-forward">
            <c-form action="{% url 'core:email_setup_instructions' 'chargify' %}">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                    <c-input name="recipient_email"
                             type="email"
                             label="Their email address"
                             placeholder="colleague@yourcompany.com"
                             autocomplete="email"
                             required
                             class="flex-1" />
                    <c-button type="submit" variant="secondary" icon="send">
                        Send instructions
                    </c-button>
                </div>
            </c-form>
        </c-card>

        <c-card title="What Chargify events become" icon="sparkles">
            <ul class="flex flex-col gap-2">
                <c-plan-card.feature>
                    A subscription starts, renews, changes or cancels
                </c-plan-card.feature>
                <c-plan-card.feature>
                    A payment fails, with the customer's history attached
                </c-plan-card.feature>
                <c-plan-card.feature>
                    A customer moves through their lifecycle
                </c-plan-card.feature>
            </ul>
        </c-card>
    </c-page>
{% endblock content %}
