{% extends "core/base.html.j2" %}

{% block title %}
    Payment methods - Notipus
{% endblock title %}

{% comment %}
Cards live in Stripe, not here: the view returns an empty list because we never
fetch them, and the Stripe customer portal is what actually adds, replaces and
removes them. This page used to render Add / Make default / Remove buttons whose
handlers showed a success toast and did nothing, so it told people their card
had been removed while it was still on file. Everything now routes to the portal,
which is the only thing that can carry the action out.
{% endcomment %}

{% block content %}
    <c-page width="narrow"
            back="{% url 'core:billing_dashboard' %}"
            back_label="Billing"
            title="Payment methods"
            subtitle="The card we charge for this workspace.">
        {% if payment_methods %}
            <c-card title="Saved cards" icon="credit-card" flush>
                <c-list>
                    {% for payment_method in payment_methods %}
                        <c-list.row title="{{ payment_method.brand|title }} ending {{ payment_method.last4 }}"
                                    description="Expires {{ payment_method.exp_month }}/{{ payment_method.exp_year }}"
                                    icon="credit-card">
                            <c-slot name="actions">
                                {% if payment_method.is_default %}<c-badge tone="success">Default</c-badge>{% endif %}
                            </c-slot>
                        </c-list.row>
                    {% endfor %}
                </c-list>
                <c-slot name="footer">
                    <c-button href="{% url 'core:billing_portal' %}"
                              variant="secondary"
                              size="sm"
                              icon="external-link">Manage cards in Stripe</c-button>
                </c-slot>
            </c-card>
        {% elif has_payment_method %}
            <c-card title="A card is on file" icon="credit-card">
                <p class="text-body text-content-muted">
                    Stripe holds your card details, so we can't show them here. Use the billing portal to see the card
                    we charge, replace it, or add a backup.
                </p>
                <c-slot name="actions">
                    <c-button href="{% url 'core:billing_portal' %}" icon="external-link">Open billing portal</c-button>
                </c-slot>
            </c-card>
        {% else %}
            <c-card>
                <c-empty-state icon="credit-card"
                               title="No payment method yet"
                               description="Add a card in the billing portal so your subscription keeps running when the trial ends.">
                    <c-slot name="actions">
                        <c-button href="{% url 'core:billing_portal' %}" icon="external-link">Open billing portal</c-button>
                    </c-slot>
                </c-empty-state>
            </c-card>
        {% endif %}

        <c-alert tone="info" title="Card details never reach our servers">
            Stripe collects and stores them directly. We only ever see the brand, the last four digits and the expiry
            date.
        </c-alert>
    </c-page>
{% endblock content %}
