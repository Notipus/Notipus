{% extends "core/base.html.j2" %}

{% block title %}
    Payment methods - Notipus
{% endblock title %}

{% block content %}
    <c-page width="narrow"
            back="{% url 'core:billing_dashboard' %}"
            back_label="Billing"
            title="Payment methods"
            subtitle="The cards we charge for this workspace.">
        {% if not has_payment_method %}
            <c-card>
                <c-empty-state icon="credit-card"
                               title="No payment method yet"
                               description="Add a card so your subscription keeps running when the trial ends.">
                    <c-slot name="actions">
                        <c-button icon="plus" onclick="addPaymentMethod()">
                            Add a card
                        </c-button>
                    </c-slot>
                </c-empty-state>
            </c-card>
        {% else %}
            <c-card title="Saved cards" icon="credit-card" flush>
                <c-list>
                    {% for payment_method in payment_methods %}
                        <c-list.row title="{{ payment_method.brand|title }} ending {{ payment_method.last4 }}"
                                    description="Expires {{ payment_method.exp_month }}/{{ payment_method.exp_year }}"
                                    icon="credit-card">
                            <c-slot name="actions">
                                {% if payment_method.is_default %}
                                    <c-badge tone="success">
                                        Default
                                    </c-badge>
                                {% else %}
                                    <c-button variant="link"
                                              size="sm"
                                              onclick="setDefaultPaymentMethod('{{ payment_method.id }}')">
                                        Make default
                                    </c-button>
                                {% endif %}
                                <c-button variant="link-danger"
                                          size="sm"
                                          onclick="deletePaymentMethod('{{ payment_method.id }}')">
                                    Remove
                                </c-button>
                            </c-slot>
                        </c-list.row>
                    {% endfor %}
                </c-list>
                <c-slot name="footer">
                    <c-button variant="secondary"
                              size="sm"
                              icon="plus"
                              onclick="addPaymentMethod()">
                        Add another card
                    </c-button>
                </c-slot>
            </c-card>
        {% endif %}

        <c-alert tone="info" title="Card details never reach our servers">
            Stripe collects and stores them directly. We only see the brand, the last four digits and the expiry date.
        </c-alert>
    </c-page>
{% endblock content %}

{% block extra_scripts %}
    <script>
        function addPaymentMethod() {
            // Placeholder until the Stripe setup flow is wired up.
            NotipusUI.toast('Adding a card is not available yet.', 'info');
        }

        async function setDefaultPaymentMethod(paymentMethodId) {
            const confirmed = await NotipusUI.confirmAction(
                'Make this the default card?',
                'Future charges for this workspace use this card.',
                'Make default'
            );
            if (confirmed) {
                NotipusUI.toast('Default card updated', 'success');
            }
        }

        async function deletePaymentMethod(paymentMethodId) {
            const confirmed = await NotipusUI.confirmDelete(
                'Any subscription paying with this card needs a new one before its next charge.',
                'card'
            );
            if (confirmed) {
                NotipusUI.toast('Card removed', 'success');
            }
        }
    </script>
{% endblock extra_scripts %}
