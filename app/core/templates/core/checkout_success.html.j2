{% extends "core/base.html.j2" %}

{% block title %}
    Payment received - Notipus
{% endblock title %}

{% block content %}
    <c-page width="narrow">
        <c-card>
            <div class="flex flex-col items-center text-center">
                <c-icon-tile name="circle-check" tone="success" size="lg" />
                <h1 class="mt-4 text-title font-bold text-content">Payment received</h1>
                <p class="mt-2 text-lead text-content-muted">
                    You're on the
                    {% if plan_name %}{{ plan_name|title }}{% endif %}
                    plan. The new limits are already live.
                </p>
            </div>

            <c-alert tone="success" title="Active on this workspace" class="mt-6">
                <ul class="flex flex-col gap-1">
                    {% if plan_name == "basic" %}
                        <li>Up to 10,000 events a month</li>
                        <li>Every integration</li>
                    {% elif plan_name == "pro" %}
                        <li>Up to 100,000 events a month</li>
                        <li>Every integration</li>
                        <li>Priority support</li>
                    {% elif plan_name == "enterprise" %}
                        <li>1,000,000 events a month</li>
                        <li>Custom integrations</li>
                        <li>A named support contact</li>
                    {% else %}
                        <li>Your new plan's limits are in effect</li>
                    {% endif %}
                </ul>
            </c-alert>

            <c-divider class="my-6" />

            <c-checklist>
                <c-checklist.item index="1"
                                  title="Check your inbox"
                                  description="Your receipt and invoice are on the way." />
                <c-checklist.item index="2"
                                  title="Connect what's left"
                                  description="More sources mean more of your business shows up in Slack."
                                  href="{% url 'core:integrations' %}" />
                <c-checklist.item index="3"
                                  title="Watch your usage"
                                  description="Billing shows how much of the new limit you're using." />
            </c-checklist>

            <div class="mt-6 flex flex-col gap-2 sm:flex-row">
                <c-button href="{% url 'core:dashboard' %}" icon="home" block>Go to dashboard</c-button>
                <c-button href="{% url 'core:billing_dashboard' %}" variant="secondary" block>View billing</c-button>
            </div>
        </c-card>

        <p class="text-center text-body text-content-muted">
            Something not right?
            <a href="mailto:billing@notipus.com"
               class="rounded-control font-medium text-brand-text underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2">
                Email billing support
            </a>
        </p>
    </c-page>
{% endblock content %}
