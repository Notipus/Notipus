{% extends "core/base.html.j2" %}

{% block title %}
    Integrations - {{ organization.name }}
{% endblock title %}

{% block content %}
    {% comment %}Flash messages render once, in base.html.j2.{% endcomment %}
    <c-page width="default"
            back="{% url 'core:dashboard' %}"
            back_label="Dashboard"
            title="Integrations"
            subtitle="Where your events come from, and where the notifications go.">
        <div class="grid gap-stack lg:grid-cols-2">
            <c-card title="Event sources"
                    description="Services that send webhooks to Notipus"
                    icon="cloud-download"
                    tone="info"
                    flush>
                <ul class="divide-y divide-border">
                    {% for integration in event_sources %}
                        {% if integration.id == "shopify" %}
                            <c-integration-row :integration="integration" provider="shopify">
                                <c-slot name="actions">
                                    {% if integration.connected %}
                                        <form method="post"
                                              action="{% url 'core:disconnect_shopify' %}"
                                              onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Disconnect Shopify?', message: 'Order notifications stop and the webhook subscriptions are removed from your store.', variant: 'warning', confirmText: 'Disconnect', cancelText: 'Keep connected'})">
                                            {% csrf_token %}
                                            <c-button type="submit" variant="ghost" size="sm" icon="unlink">
                                                Disconnect
                                            </c-button>
                                        </form>
                                    {% else %}
                                        <c-button href="{% url 'core:integrate_shopify' %}"
                                                  size="sm"
                                                  icon="plug-connected">Connect</c-button>
                                    {% endif %}
                                </c-slot>
                            </c-integration-row>
                        {% elif integration.id == "chargify" %}
                            <c-integration-row :integration="integration" provider="chargify">
                                <c-slot name="actions">
                                    <c-button href="{% url 'core:integrate_chargify' %}"
                                              size="sm"
                                              variant="{% if integration.connected %}ghost{% else %}primary{% endif %}"
                                              icon="{% if integration.connected %}settings{% else %}plug-connected{% endif %}">
                                        {% if integration.connected %}
                                            Configure
                                        {% else %}
                                            Connect
                                        {% endif %}
                                    </c-button>
                                </c-slot>
                            </c-integration-row>
                        {% elif integration.id == "stripe_customer" %}
                            <c-integration-row :integration="integration" provider="stripe">
                                <c-slot name="actions">
                                    <c-button href="{% url 'core:integrate_stripe' %}"
                                              size="sm"
                                              variant="{% if integration.connected %}ghost{% else %}primary{% endif %}"
                                              icon="{% if integration.connected %}settings{% else %}plug-connected{% endif %}">
                                        {% if integration.connected %}
                                            Configure
                                        {% else %}
                                            Connect
                                        {% endif %}
                                    </c-button>
                                    {% if integration.connected %}
                                        <form method="post"
                                              action="{% url 'core:disconnect_stripe' %}"
                                              onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Disconnect Stripe?', message: 'Payment notifications stop. Remember to remove the webhook from your Stripe dashboard too.', variant: 'warning', confirmText: 'Disconnect', cancelText: 'Keep connected'})">
                                            {% csrf_token %}
                                            <c-button type="submit" variant="ghost" size="sm" icon="unlink">
                                                Disconnect
                                            </c-button>
                                        </form>
                                    {% endif %}
                                </c-slot>
                            </c-integration-row>
                        {% else %}
                            <c-integration-row :integration="integration" provider="{{ integration.id }}">
                                <c-slot name="actions">
                                    <c-badge>
                                        Coming soon
                                    </c-badge>
                                </c-slot>
                            </c-integration-row>
                        {% endif %}
                    {% endfor %}
                </ul>
            </c-card>

            <c-card title="Notification channels"
                    description="Where alerts are delivered"
                    icon="send"
                    tone="success"
                    flush>
                <ul class="divide-y divide-border">
                    {% for integration in notification_channels %}
                        {% if integration.id == "slack_notifications" %}
                            <c-integration-row :integration="integration" provider="slack">
                                <c-slot name="actions">
                                    {% if integration.connected %}
                                        <c-button variant="ghost"
                                                  size="sm"
                                                  icon="settings"
                                                  onclick="openSlackConfigModal()">
                                            Configure
                                        </c-button>
                                        <form method="post" action="{% url 'core:test_slack' %}">
                                            {% csrf_token %}
                                            <c-button type="submit" variant="ghost" size="sm" icon="send">
                                                Send test
                                            </c-button>
                                        </form>
                                        <form method="post"
                                              action="{% url 'core:disconnect_slack' %}"
                                              onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Disconnect Slack?', message: 'Notifications stop arriving. You can reconnect at any time.', variant: 'warning', confirmText: 'Disconnect', cancelText: 'Keep connected'})">
                                            {% csrf_token %}
                                            <c-button type="submit" variant="ghost" size="sm" icon="unlink">
                                                Disconnect
                                            </c-button>
                                        </form>
                                    {% else %}
                                        <c-button href="{% url 'core:integrate_slack' %}"
                                                  size="sm"
                                                  icon="plug-connected">Connect</c-button>
                                    {% endif %}
                                </c-slot>
                            </c-integration-row>
                        {% elif integration.id == "telegram_notifications" %}
                            <c-integration-row :integration="integration" provider="telegram">
                                <c-slot name="actions">
                                    {% if integration.connected %}
                                        <c-button href="{% url 'core:telegram_connect' %}"
                                                  variant="ghost"
                                                  size="sm"
                                                  icon="settings">Configure</c-button>
                                        <form method="post" action="{% url 'core:test_telegram' %}">
                                            {% csrf_token %}
                                            <c-button type="submit" variant="ghost" size="sm" icon="send">
                                                Send test
                                            </c-button>
                                        </form>
                                        <form method="post"
                                              action="{% url 'core:disconnect_telegram' %}"
                                              onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Disconnect Telegram?', message: 'Notifications stop arriving in Telegram. You can reconnect at any time.', variant: 'warning', confirmText: 'Disconnect', cancelText: 'Keep connected'})">
                                            {% csrf_token %}
                                            <c-button type="submit" variant="ghost" size="sm" icon="unlink">
                                                Disconnect
                                            </c-button>
                                        </form>
                                    {% else %}
                                        <c-button href="{% url 'core:telegram_connect' %}"
                                                  size="sm"
                                                  icon="plug-connected">Connect</c-button>
                                    {% endif %}
                                </c-slot>
                            </c-integration-row>
                        {% elif integration.id == "teams_notifications" %}
                            <c-integration-row :integration="integration" provider="teams">
                                <c-slot name="actions">
                                    {% if integration.connected %}
                                        <c-button href="{% url 'core:teams_connect' %}"
                                                  variant="ghost"
                                                  size="sm"
                                                  icon="settings">Configure</c-button>
                                        <form method="post" action="{% url 'core:test_teams' %}">
                                            {% csrf_token %}
                                            <c-button type="submit" variant="ghost" size="sm" icon="send">
                                                Send test
                                            </c-button>
                                        </form>
                                        <form method="post"
                                              action="{% url 'core:disconnect_teams' %}"
                                              onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Disconnect Microsoft Teams?', message: 'Notifications stop arriving in Teams. You can reconnect at any time.', variant: 'warning', confirmText: 'Disconnect', cancelText: 'Keep connected'})">
                                            {% csrf_token %}
                                            <c-button type="submit" variant="ghost" size="sm" icon="unlink">
                                                Disconnect
                                            </c-button>
                                        </form>
                                    {% else %}
                                        <c-button href="{% url 'core:teams_connect' %}" size="sm" icon="plug-connected">Connect</c-button>
                                    {% endif %}
                                </c-slot>
                            </c-integration-row>
                        {% else %}
                            <c-integration-row :integration="integration" provider="{{ integration.id }}">
                                <c-slot name="actions">
                                    <c-badge>
                                        Coming soon
                                    </c-badge>
                                </c-slot>
                            </c-integration-row>
                        {% endif %}
                    {% endfor %}
                </ul>
                <c-slot name="footer">
                    Discord and email are next.
                </c-slot>
            </c-card>
        </div>

        {% if enrichment_services %}
            <c-card title="Enrichment"
                    description="Extra context attached to each event before it reaches you"
                    icon="sparkles"
                    flush>
                <ul class="divide-y divide-border">
                    {% for integration in enrichment_services %}
                        {% if integration.id == "hunter" %}
                            <c-integration-row :integration="integration" provider="hunter">
                                <c-slot name="actions">
                                    <c-button href="{% url 'core:integrate_hunter' %}"
                                              size="sm"
                                              variant="{% if integration.connected %}ghost{% else %}primary{% endif %}"
                                              icon="{% if integration.connected %}settings{% else %}plug-connected{% endif %}">
                                        {% if integration.connected %}
                                            Configure
                                        {% else %}
                                            Connect
                                        {% endif %}
                                    </c-button>
                                    {% if integration.connected %}
                                        <form method="post"
                                              action="{% url 'core:disconnect_hunter' %}"
                                              onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Disconnect Hunter.io?', message: 'Customer emails stop being enriched with person data. You can reconnect at any time.', variant: 'warning', confirmText: 'Disconnect', cancelText: 'Keep connected'})">
                                            {% csrf_token %}
                                            <c-button type="submit" variant="ghost" size="sm" icon="unlink">
                                                Disconnect
                                            </c-button>
                                        </form>
                                    {% endif %}
                                </c-slot>
                            </c-integration-row>
                        {% else %}
                            <c-integration-row :integration="integration" provider="{{ integration.id }}">
                                <c-slot name="actions">
                                    <c-badge>
                                        Coming soon
                                    </c-badge>
                                </c-slot>
                            </c-integration-row>
                        {% endif %}
                    {% endfor %}
                </ul>
            </c-card>
        {% endif %}

        <c-card title="How this fits together" icon="help-circle" tone="info">
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <h3 class="flex items-center gap-2 text-body font-semibold text-content">
                        <i class="ti ti-cloud-download text-info-text" aria-hidden="true"></i>
                        Event sources
                    </h3>
                    <p class="mt-1 text-body text-content-muted">
                        You point a provider's webhook at a Notipus URL. We verify the signature, work out what
                        happened, and enrich it with what we know about the customer.
                    </p>
                </div>
                <div>
                    <h3 class="flex items-center gap-2 text-body font-semibold text-content">
                        <i class="ti ti-send text-success-text" aria-hidden="true"></i>
                        Notification channels
                    </h3>
                    <p class="mt-1 text-body text-content-muted">
                        You pick a channel and which events are worth interrupting someone for. Delivery happens within
                        seconds of the event.
                    </p>
                </div>
            </div>
        </c-card>
    </c-page>

    <c-dialog id="slack-config-modal"
              title="Choose a Slack channel"
              description="Notifications for this workspace are posted here."
              icon="brand-slack">
        <c-field label="Channel" for="slack-channel-select">
            <p id="slack-channel-loading"
               class="flex items-center gap-2 text-body text-content-muted">
                <i class="ti ti-loader-2 animate-spin" aria-hidden="true"></i>
                Loading your channels…
            </p>
            {% comment %}Options are filled in by openSlackConfigModal below.{% endcomment %}
            <c-select id="slack-channel-select" bare class="hidden" />
            <p id="slack-channel-error"
               class="mt-1.5 hidden text-body text-danger-text"
               role="alert"></p>
        </c-field>
        <c-slot name="actions">
            <c-button id="slack-config-save"
                      icon="check"
                      onclick="saveSlackConfig()"
                      disabled>
                Save channel
            </c-button>
            <c-button variant="secondary" onclick="closeSlackConfigModal()">
                Cancel
            </c-button>
        </c-slot>
    </c-dialog>
{% endblock content %}

{% block extra_scripts %}
    <script>
        function closeSlackConfigModal() {
            const modal = document.getElementById('slack-config-modal');
            modal.classList.add('hidden');
            modal.setAttribute('aria-hidden', 'true');
        }

        async function openSlackConfigModal() {
            const modal = document.getElementById('slack-config-modal');
            const loading = document.getElementById('slack-channel-loading');
            const select = document.getElementById('slack-channel-select');
            const errorEl = document.getElementById('slack-channel-error');
            const saveBtn = document.getElementById('slack-config-save');

            loading.classList.remove('hidden');
            select.classList.add('hidden');
            errorEl.classList.add('hidden');
            saveBtn.disabled = true;

            modal.classList.remove('hidden');
            modal.setAttribute('aria-hidden', 'false');

            try {
                const response = await fetch('{% url "core:get_slack_channels" %}');
                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'We could not load your channels.');
                }

                select.innerHTML = '';
                data.channels.forEach(channel => {
                    const option = document.createElement('option');
                    option.value = `#${channel.name}`;
                    option.textContent = `#${channel.name}`;
                    if (`#${channel.name}` === data.current_channel) {
                        option.selected = true;
                    }
                    select.appendChild(option);
                });

                loading.classList.add('hidden');
                select.classList.remove('hidden');
                saveBtn.disabled = false;
            } catch (error) {
                loading.classList.add('hidden');
                errorEl.textContent = error.message;
                errorEl.classList.remove('hidden');
            }
        }

        async function saveSlackConfig() {
            const select = document.getElementById('slack-channel-select');
            const saveBtn = document.getElementById('slack-config-save');
            const errorEl = document.getElementById('slack-channel-error');
            const channel = select.value;
            const originalHtml = saveBtn.innerHTML;

            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="ti ti-loader-2 animate-spin" aria-hidden="true"></i> Saving…';
            errorEl.classList.add('hidden');

            try {
                const response = await fetch('{% url "core:configure_slack" %}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRFToken': '{{ csrf_token }}',
                    },
                    body: JSON.stringify({
                        channel: channel
                    }),
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'We could not save that channel.');
                }

                closeSlackConfigModal();
                NotipusUI.toast(`Notifications now go to ${channel}`, 'success');
            } catch (error) {
                errorEl.textContent = error.message;
                errorEl.classList.remove('hidden');
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalHtml;
            }
        }

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modal = document.getElementById('slack-config-modal');
                if (!modal.classList.contains('hidden')) {
                    closeSlackConfigModal();
                }
            }
        });
    </script>
{% endblock extra_scripts %}
