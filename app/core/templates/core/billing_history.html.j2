{% extends "core/base.html.j2" %}
{% load humanize %}

{% block title %}
    Invoices - Notipus
{% endblock title %}

{% block content %}
    <c-page back="{% url 'core:billing_dashboard' %}"
            back_label="Billing"
            title="Invoices"
            subtitle="Every charge on this workspace, with receipts to download.">
        {% if invoices %}
            <c-card title="Invoices and payments" icon="file-invoice" flush>
                <c-table caption="Invoices for {{ workspace.name }}">
                    <c-slot name="head">
                        <c-table.column>
                            Invoice
                        </c-table.column>
                        <c-table.column>
                            Date
                        </c-table.column>
                        <c-table.column align="right">
                            Amount
                        </c-table.column>
                        <c-table.column>
                            Status
                        </c-table.column>
                        <c-table.column align="right">
                            Receipt
                        </c-table.column>
                    </c-slot>
                    {% for invoice in invoices %}
                        <tr class="transition-colors hover:bg-surface-muted">
                            <c-table.cell>
                                <span class="block font-medium text-content">{{ invoice.number }}</span>
                                <span class="block text-content-muted">{{ invoice.description }}</span>
                            </c-table.cell>
                            <c-table.cell muted>
                                {{ invoice.date|date:"M j, Y" }}
                            </c-table.cell>
                            <c-table.cell align="right" class="font-mono">
                                ${{ invoice.amount|floatformat:2|intcomma }}
                            </c-table.cell>
                            <c-table.cell>
                                {% if invoice.status == "paid" %}
                                    <c-badge tone="success" icon="circle-check">
                                        Paid
                                    </c-badge>
                                {% elif invoice.status == "pending" %}
                                    <c-badge tone="warning" icon="clock">
                                        Pending
                                    </c-badge>
                                {% elif invoice.status == "failed" %}
                                    <c-badge tone="danger" icon="circle-x">
                                        Failed
                                    </c-badge>
                                {% else %}
                                    <c-badge>
                                        {{ invoice.status|title }}
                                    </c-badge>
                                {% endif %}
                            </c-table.cell>
                            {% comment %}
                            Stripe hosts the receipts; we never generate PDFs. This used to
                            call a downloadInvoice() stub that only raised a toast.
                            {% endcomment %}
                            <c-table.cell align="right">
                                <c-button href="{% url 'core:billing_portal' %}" variant="link" size="sm">Receipt</c-button>
                            </c-table.cell>
                        </tr>
                    {% endfor %}
                </c-table>
            </c-card>
        {% else %}
            <c-card>
                <c-empty-state icon="file-invoice"
                               title="No invoices yet"
                               description="{% if workspace.subscription_status == 'trial' %}You're trialing the {{ workspace.subscription_plan|title }} plan. Your first invoice appears here when the trial ends.{% else %}Charges and receipts appear here once your first payment goes through.{% endif %}">
                    <c-slot name="actions">
                        {% if workspace.subscription_plan == "free" %}
                            <c-button href="{% url 'core:upgrade_plan' %}" icon="trending-up">Choose a paid plan</c-button>
                        {% elif workspace.subscription_status == "trial" %}
                            <c-button href="{% url 'core:billing_portal' %}"
                                      variant="secondary"
                                      icon="settings">
                                Manage subscription
                            </c-button>
                        {% endif %}
                    </c-slot>
                </c-empty-state>
            </c-card>
        {% endif %}

        <div class="grid gap-stack sm:grid-cols-2">
            <c-card>
                <c-stat label="This month"
                        value="${{ current_month_amount|floatformat:2|intcomma }}"
                        icon="calendar-month" />
            </c-card>
            <c-card>
                <c-stat label="{% if workspace.subscription_status == 'trial' %}Trial ends in{% else %}Next payment{% endif %}"
                        value="{% if workspace.subscription_status == 'trial' %}{{ trial_days_remaining }}{% else %}{{ rate_limit_info.reset_time|date:'M j' }}{% endif %}"
                        unit="{% if workspace.subscription_status == 'trial' %}day{{ trial_days_remaining|pluralize }}{% endif %}"
                        icon="clock" />
            </c-card>
        </div>

        <c-alert tone="info" title="Questions about a charge?">
            Email <a href="mailto:billing@notipus.com"
    class="font-medium underline underline-offset-4">billing@notipus.com</a>
            with the invoice number and we'll look into it.
        </c-alert>
    </c-page>
{% endblock content %}
