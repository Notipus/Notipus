{% extends "core/base.html.j2" %}

{% block title %}
    Connect Telegram - Notipus
{% endblock title %}

{% block content %}
    <c-page back="{% url 'core:integrations' %}"
            back_label="Integrations"
            title="Connect Telegram"
            subtitle="Notifications in a Telegram chat, group or channel, via a bot you own.">
        {% if existing_integration %}
            <c-alert tone="success" title="Telegram is connected">
                {% if existing_integration.integration_settings.bot_username %}
                    Delivering through @{{ existing_integration.integration_settings.bot_username }}.
                {% endif %}
                Re-enter the token below to point it at a different bot.
            </c-alert>
        {% endif %}

        <c-card title="Bot credentials"
                description="Both come from Telegram; the steps below explain where."
                icon="robot">
            <c-form>
                {% comment %}
                The stored bot token is never rendered back into this field. Even in a
                password input it would sit in the DOM where an extension or injected
                script could read it, so updating means re-entering it.
                {% endcomment %}
                <c-input name="bot_token"
                         label="Bot token"
                         placeholder="123456789:ABCdefGHIjklmnOPQrstUVwxyz"
                         help="From @BotFather.{% if existing_integration %} Re-enter it to update the connection.{% endif %}"
                         secret
                         required />
                <c-input name="chat_id"
                         label="Chat ID"
                         value="{% if existing_integration %}{{ existing_integration.oauth_credentials.chat_id }}{% endif %}"
                         placeholder="-1001234567890 or 123456789"
                         help="The chat, group or channel that receives the messages. Group and channel IDs start with -100."
                         required />
                <c-slot name="actions">
                    <c-button type="submit" icon="plug-connected">
                        {% if existing_integration %}
                            Update connection
                        {% else %}
                            Connect Telegram
                        {% endif %}
                    </c-button>
                </c-slot>
            </c-form>
        </c-card>

        <c-card title="Where to find those" icon="list-check">
            <c-checklist>
                <c-checklist.item index="1" title="Create a bot">
                    <p class="text-body text-content-muted">
                        Open
                        <a href="https://t.me/botfather"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="font-medium text-brand-text underline-offset-4 hover:underline">@BotFather</a>,
                        send <code class="rounded bg-surface-muted px-1 font-mono">/newbot</code>, and copy the token it
                        gives you.
                    </p>
                </c-checklist.item>
                <c-checklist.item index="2" title="Let the bot into the conversation">
                    <p class="text-body text-content-muted">
                        For a private chat, message the bot. For a group, add it as a member. For a channel, add it as
                        an administrator.
                    </p>
                </c-checklist.item>
                <c-checklist.item index="3" title="Find the chat ID">
                    <p class="text-body text-content-muted">
                        Add
                        <a href="https://t.me/userinfobot"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="font-medium text-brand-text underline-offset-4 hover:underline">@userinfobot</a>
                        to the conversation and forward it a message, or use
                        <a href="https://t.me/raw_data_bot"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="font-medium text-brand-text underline-offset-4 hover:underline">@raw_data_bot</a>.
                    </p>
                </c-checklist.item>
                <c-checklist.item index="4"
                                  title="Connect, then test"
                                  description="Send test from the integrations page to confirm the message lands." />
            </c-checklist>
        </c-card>

        <c-card title="What arrives in Telegram" icon="sparkles">
            <ul class="flex flex-col gap-2">
                <c-plan-card.feature>
                    Payments and subscription changes as they happen
                </c-plan-card.feature>
                <c-plan-card.feature>
                    Customer and company context in the message itself
                </c-plan-card.feature>
                <c-plan-card.feature>
                    Buttons through to the order or payment in Stripe or Shopify
                </c-plan-card.feature>
                <c-plan-card.feature>
                    Works alongside Slack — you can have both
                </c-plan-card.feature>
            </ul>
        </c-card>
    </c-page>
{% endblock content %}
