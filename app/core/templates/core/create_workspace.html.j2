{% extends "core/base.html.j2" %}

{% block title %}
    Create workspace - Notipus
{% endblock title %}

{% block content %}
    <c-page width="narrow"
            title="Create your workspace"
            subtitle="A workspace holds your integrations, your team and your notification history.">
        <c-card>
            <c-form>
                <c-input name="name"
                         label="Workspace name"
                         :value="suggested_name"
                         placeholder="Your company name"
                         help="Shown throughout Notipus and in your notifications."
                         maxlength="200"
                         required
                         autofocus />
                <c-input name="shop_domain"
                         label="Business domain"
                         placeholder="yourbusiness.com"
                         help="Your main website. Optional — you can add it later." />
                <c-slot name="actions">
                    <c-button type="submit" block>
                        Create workspace
                    </c-button>
                </c-slot>
            </c-form>
        </c-card>

        <c-card title="What happens next" icon="route">
            <c-checklist>
                <c-checklist.item index="1"
                                  title="Connect Slack"
                                  description="Choose the channel your notifications land in." />
                <c-checklist.item index="2"
                                  title="Connect a payment provider"
                                  description="Stripe, Shopify or Chargify — this is where events come from." />
                <c-checklist.item index="3"
                                  title="Choose your events"
                                  description="Pick which payments and orders are worth interrupting someone for." />
            </c-checklist>
        </c-card>
    </c-page>
{% endblock content %}
