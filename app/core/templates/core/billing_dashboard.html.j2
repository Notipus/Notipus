{% extends "core/base.html.j2" %}
{% load humanize %}

{% block title %}
    Billing - Notipus
{% endblock title %}

{% block content %}
    <c-page width="narrow"
            back="{% url 'core:dashboard' %}"
            back_label="Dashboard"
            title="Billing"
            subtitle="Your plan, your usage this month and what happens next.">
        {% if trial_has_ended %}
            <c-alert tone="warning" title="Your trial has ended">
                Notifications are paused until you choose a plan.
                <c-slot name="actions">
                    <c-button href="{% url 'core:upgrade_plan' %}" size="sm">Choose a plan</c-button>
                </c-slot>
            </c-alert>
        {% endif %}

        <c-card title="{{ current_plan|title }} plan"
                :description="workspace.name"
                icon="crown">
            <c-slot name="actions">
                {% if workspace.subscription_status == "trial" %}
                    <c-badge tone="warning" icon="clock">
                        Trial
                    </c-badge>
                {% elif workspace.subscription_status == "active" %}
                    <c-badge tone="success" icon="circle-check">
                        Active
                    </c-badge>
                {% elif workspace.subscription_status == "suspended" %}
                    <c-badge tone="danger" icon="alert-triangle">
                        Suspended
                    </c-badge>
                {% else %}
                    <c-badge>
                        {{ workspace.subscription_status|title }}
                    </c-badge>
                {% endif %}
            </c-slot>

            <div class="flex flex-col gap-5">
                <div>
                    <div class="mb-2 flex items-baseline justify-between gap-2">
                        <span class="text-body font-medium text-content">Events this month</span>
                        <span class="text-body text-content-muted">
                            {{ rate_limit_info.current_usage|floatformat:0|intcomma }} of
                            {{ rate_limit_info.limit|floatformat:0|intcomma }}
                        </span>
                    </div>
                    <c-progress :value="usage_percentage"
                                label="Monthly event usage"
                                tone="{% if usage_percentage >= 90 %}danger{% elif usage_percentage >= 75 %}warning{% else %}brand{% endif %}" />
                    {% if usage_percentage >= 90 %}
                        <p class="mt-2 flex items-center gap-1 text-body text-danger-text">
                            <i class="ti ti-alert-circle" aria-hidden="true"></i>
                            You're close to this month's limit.
                        </p>
                    {% endif %}
                </div>

                <div class="grid gap-4 border-t border-border pt-5 sm:grid-cols-2">
                    <c-stat label="{% if workspace.subscription_plan == 'free' %}Cost{% elif workspace.subscription_status == 'trial' %}After the trial{% else %}Monthly cost{% endif %}"
                            value="{% if workspace.subscription_plan == 'free' %}Free{% elif current_plan_obj %}${{ current_plan_obj.price_monthly|floatformat:0 }}{% else %}—{% endif %}"
                            unit="{% if workspace.subscription_plan == 'free' %}forever{% elif workspace.subscription_status != 'trial' %}per month{% endif %}"
                            icon="currency-dollar" />
                    <c-stat label="{% if workspace.subscription_plan == 'free' %}Renewal{% elif workspace.subscription_status == 'trial' %}Trial ends in{% else %}Next renewal{% endif %}"
                            value="{% if workspace.subscription_plan == 'free' %}—{% elif workspace.subscription_status == 'trial' %}{{ trial_days_remaining }}{% else %}{{ rate_limit_info.reset_time|date:'M j' }}{% endif %}"
                            unit="{% if workspace.subscription_status == 'trial' %}days{% endif %}"
                            icon="calendar-event" />
                </div>
            </div>
        </c-card>

        {% if workspace.subscription_plan == "free" %}
            <c-card title="Room to grow"
                    description="Paid plans raise your monthly event limit and add seats."
                    icon="rocket">
                <c-slot name="actions">
                    <c-button href="{% url 'core:upgrade_plan' %}" icon="arrow-up-right">View plans</c-button>
                </c-slot>
            </c-card>
        {% elif workspace.subscription_status == "trial" %}
            <c-card title="Trial in progress"
                    description="You're on {{ workspace.subscription_plan|title }} for another {{ trial_days_remaining }} day{{ trial_days_remaining|pluralize }}."
                    icon="clock"
                    tone="warning">
                <c-slot name="actions">
                    <c-button href="{% url 'core:billing_portal' %}" icon="settings">Manage subscription</c-button>
                </c-slot>
            </c-card>
        {% elif available_plans %}
            <c-card title="Other plans"
                    description="Higher limits, more seats and longer history."
                    icon="sparkles"
                    tone="neutral">
                <c-slot name="actions">
                    <c-button href="{% url 'core:upgrade_plan' %}"
                              variant="secondary"
                              icon="chevron-right"
                              trailing>
                        View plans
                    </c-button>
                </c-slot>
            </c-card>
        {% endif %}

        <c-card title="Billing details" icon="receipt-2" flush>
            <div class="flex flex-col gap-3 p-gutter">
                <c-action-row href="{% url 'core:payment_methods' %}"
                              icon="credit-card"
                              title="Payment methods"
                              description="The card we charge each month." />
                <c-action-row href="{% url 'core:billing_history' %}"
                              icon="file-invoice"
                              title="Invoices"
                              description="Every charge, with receipts to download." />
            </div>
        </c-card>
    </c-page>
{% endblock content %}
