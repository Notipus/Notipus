{% extends "core/base.html.j2" %}

{% block title %}
    Join {{ workspace.name }} - Notipus
{% endblock title %}

{% block content %}
    <c-page width="narrow">
        <c-card>
            <div class="flex flex-col items-center text-center">
                <c-avatar :name="workspace.name" size="lg" />
                <h1 class="mt-4 text-title font-bold text-content">Join {{ workspace.name }}</h1>
                <p class="mt-2 text-lead text-content-muted">{{ invitation.invited_by.email }} invited you to this workspace.</p>
            </div>

            <c-definition class="mt-6">
                <c-definition.row label="Invitation sent to" :value="invitation.email" />
                <c-definition.row label="Role">
                    <c-badge tone="brand">
                        {{ invitation.role|title }}
                    </c-badge>
                </c-definition.row>
                <c-definition.row label="Expires" value="{{ invitation.expires_at|date:'M j, Y' }}" />
            </c-definition>

            <div class="mt-6 flex flex-col gap-3">
                {% if user.is_authenticated %}
                    {% if user.email|lower == invitation.email|lower %}
                        <c-form action="{% url 'core:confirm_accept_invitation' invitation.token %}">
                            <c-button type="submit" block>
                                Join {{ workspace.name }}
                            </c-button>
                        </c-form>
                    {% else %}
                        <c-alert tone="warning" title="This invitation is for a different account">
                            You are signed in as {{ user.email }}, but the invitation was sent to {{ invitation.email }}.
                            Sign out and sign back in as {{ invitation.email }} to accept it.
                        </c-alert>
                        <c-button href="{% url 'account_logout' %}?next={{ request.path }}"
                                  variant="secondary"
                                  block>
                            Sign out and use another account
                        </c-button>
                    {% endif %}
                {% else %}
                    <c-button href="{% url 'account_login' %}?next={{ request.path }}" block>Sign in to accept</c-button>
                    <c-divider label="or" />
                    <c-button href="{% url 'account_signup' %}?next={{ request.path }}&email={{ invitation.email|urlencode }}"
                              variant="secondary"
                              block>
                        Create an account
                    </c-button>
                {% endif %}
            </div>
        </c-card>
    </c-page>
{% endblock content %}
