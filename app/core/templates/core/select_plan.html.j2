{% extends "core/base.html.j2" %}

{% block title %}
    Choose a plan - Notipus
{% endblock title %}

{% block content %}
    <c-page width="wide"
            title="Choose a plan"
            subtitle="Start free with 20 events a month, or try any paid plan free for 14 days.">
        <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
            {% for plan in plans %}
                <c-plan-card :name="plan.display_name"
                             :price="plan.price"
                             period="{% if '$' in plan.price %}/month{% endif %}"
                             :description="plan.description"
                             featured="{% if plan.name == 'pro' %}1{% endif %}">
                    <c-slot name="actions">
                        <c-form>
                            <input type="hidden" name="plan" value="{{ plan.name }}">
                            <c-button type="submit"
                                      variant="{% if plan.name == 'pro' %}primary{% else %}secondary{% endif %}"
                                      block>
                                {% if plan.name == "free" %}
                                    Start free
                                {% else %}
                                    Start 14-day trial
                                {% endif %}
                            </c-button>
                        </c-form>
                    </c-slot>
                    <c-slot name="features">
                        {% for feature in plan.features %}<c-plan-card.feature>{{ feature }}</c-plan-card.feature>{% endfor %}
                    </c-slot>
                </c-plan-card>
            {% endfor %}
        </div>

        <c-card title="Questions people ask before choosing" icon="help-circle">
            <div class="flex flex-col gap-5">
                <div>
                    <h3 class="text-body font-semibold text-content">Can I change plan later?</h3>
                    <p class="mt-1 text-body text-content-muted">
                        Yes, at any time. Changes take effect immediately and we prorate the difference.
                    </p>
                </div>
                <div>
                    <h3 class="text-body font-semibold text-content">How does the free trial work?</h3>
                    <p class="mt-1 text-body text-content-muted">
                        Every paid plan includes 14 days free. You enter card details up front but are not charged until
                        the trial ends. The Free plan has no trial — it stays free, with 20 events a month.
                    </p>
                </div>
                <div>
                    <h3 class="text-body font-semibold text-content">Do you offer annual billing?</h3>
                    <p class="mt-1 text-body text-content-muted">
                        Yes. Once your workspace is set up you can switch to annual billing from the Billing page, where
                        each plan's yearly price and saving is shown.
                    </p>
                </div>
            </div>
        </c-card>

        <p class="text-center text-body text-content-muted">
            Still deciding?
            <a href="mailto:support@notipus.com"
               class="rounded-control font-medium text-brand-text underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2">
                Ask us anything
            </a>
        </p>
    </c-page>
{% endblock content %}
