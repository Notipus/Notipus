{% extends "core/base.html.j2" %}

{% block title %}
    Checkout cancelled - Notipus
{% endblock title %}

{% block content %}
    <c-page width="narrow">
        <c-card>
            <div class="flex flex-col items-center text-center">
                <c-icon-tile name="x" tone="neutral" size="lg" />
                <h1 class="mt-4 text-title font-bold text-content">Checkout cancelled</h1>
                <p class="mt-2 text-lead text-content-muted">Nothing was charged and your current plan is unchanged.</p>
            </div>

            <div class="mt-6 flex flex-col gap-2 sm:flex-row">
                <c-button href="{% url 'core:upgrade_plan' %}" icon="arrow-left" block>Back to plans</c-button>
                <c-button href="{% url 'core:dashboard' %}" variant="secondary" block>Go to dashboard</c-button>
            </div>
        </c-card>

        <c-card title="What a paid plan changes" icon="sparkles">
            <div class="grid gap-5 sm:grid-cols-3">
                <c-feature layout="stack"
                           icon="bolt"
                           title="More events"
                           description="Room for a busy month without delivery pausing." />
                <c-feature layout="stack"
                           icon="users"
                           title="More seats"
                           description="Bring the rest of the team into the workspace." />
                <c-feature layout="stack"
                           icon="lifebuoy"
                           title="Priority support"
                           description="A faster answer when a webhook stops arriving." />
            </div>
            <c-slot name="footer">
                <a href="mailto:billing@notipus.com"
                   class="rounded-control font-medium text-brand-text underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2">
                    Ask billing a question
                </a>
            </c-slot>
        </c-card>
    </c-page>
{% endblock content %}
