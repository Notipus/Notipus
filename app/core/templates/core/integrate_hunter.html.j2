{% extends "core/base.html.j2" %}

{% block title %}
    Connect Hunter.io - Notipus
{% endblock title %}

{% block content %}
    <c-page back="{% url 'core:integrations' %}"
            back_label="Integrations"
            title="Connect Hunter.io"
            subtitle="Turn a customer's email address into a name, a job title and a profile link.">
        {% if existing_integration and has_api_key %}
            <c-alert tone="success" title="Hunter.io is connected">
                New customer emails are enriched before their notification is sent.
            </c-alert>
        {% endif %}

        <c-alert tone="warning" title="This sends customer emails to a third party">
            Enabling it means customer email addresses from your webhooks are sent to Hunter.io for lookup. Hunter.io is
            GDPR compliant and returns nothing for people who have opted out. Make sure your privacy policy covers it.
        </c-alert>

        <c-card title="Your API key"
                description="Hunter.io bills your account, not ours."
                icon="key">
            <c-form>
                <c-checklist class="mb-5">
                    <c-checklist.item index="1" title="Create a Hunter.io account">
                        <p class="text-body text-content-muted">
                            <a href="https://hunter.io/users/sign_up"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="font-medium text-brand-text underline-offset-4 hover:underline">hunter.io/users/sign_up</a>
                            — the free plan includes 25 lookups a month.
                        </p>
                    </c-checklist.item>
                    <c-checklist.item index="2" title="Open your API keys">
                        <p class="text-body text-content-muted">
                            <a href="https://hunter.io/api_keys"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="font-medium text-brand-text underline-offset-4 hover:underline">hunter.io/api_keys</a>
                        </p>
                    </c-checklist.item>
                    <c-checklist.item index="3" title="Paste the key below" />
                </c-checklist>

                <c-input name="api_key"
                         label="Hunter.io API key"
                         placeholder="{% if has_api_key %}Enter a new key to replace the saved one{% else %}Paste your key{% endif %}"
                         help="{% if has_api_key %}A key is already saved. Leave this blank unless you're replacing it.{% else %}Stored encrypted; we never show it back to you.{% endif %}"
                         secret
                         required />

                <c-slot name="actions">
                    <c-button type="submit" icon="plug-connected">
                        {% if existing_integration %}
                            Update Hunter.io
                        {% else %}
                            Connect Hunter.io
                        {% endif %}
                    </c-button>
                </c-slot>
            </c-form>
        </c-card>

        <c-card title="What gets added to a notification" icon="user-search">
            <div class="grid gap-3 sm:grid-cols-2">
                <c-feature icon="user"
                           title="Name"
                           description="From their professional profile" />
                <c-feature icon="briefcase"
                           title="Job title and seniority"
                           description="Who you're actually talking to" />
                <c-feature icon="brand-linkedin"
                           title="Profile links"
                           description="LinkedIn, X and GitHub where known" />
                <c-feature icon="map-pin" title="Location" description="City and region" />
            </div>
            <c-slot name="footer">
                Lookups are cached, so repeat customers don't spend a second credit. Free-provider addresses such as
                Gmail work too.
            </c-slot>
        </c-card>
    </c-page>
{% endblock content %}
