{% extends "core/base.html.j2" %}

{% block title %}
    Connect Stripe - Notipus
{% endblock title %}

{% block content %}
    <c-page back="{% url 'core:integrations' %}"
            back_label="Integrations"
            title="Connect Stripe"
            subtitle="Payments, subscriptions and trials from your Stripe account, delivered where your team already is.">
        {% if existing_integration and existing_integration.is_webhook_verified %}
            <c-alert tone="success" title="Stripe is connected">
                Events are arriving. Paste a new signing secret below if you ever roll it.
            </c-alert>
        {% elif existing_integration %}
            <c-alert tone="warning" title="Waiting for the first event">
                Your signing secret is saved. Send a test webhook from Stripe and this turns green.
            </c-alert>
        {% endif %}

        <c-card title="Set up the webhook"
                description="Stripe gives you the signing secret at the end; paste it in step 5."
                icon="list-numbers">
            <c-form>
                <c-checklist>
                    <c-checklist.item index="1" title="Open your Stripe dashboard">
                        <p class="text-body text-content-muted">
                            Go to
                            <a href="https://dashboard.stripe.com/webhooks/create"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="font-medium text-brand-text underline-offset-4 hover:underline">Developers → Webhooks</a>
                            and choose "Add destination".
                        </p>
                    </c-checklist.item>

                    <c-checklist.item index="2" title="Select the events to send">
                        <p class="text-body text-content-muted">
                            Under "Events from" pick <strong>Your account</strong>, then add each of these.
                        </p>
                        <div class="mt-3 flex flex-col gap-2">
                            {% for event in webhook_events %}
                                <div class="flex items-center gap-2">
                                    <i class="ti ti-check flex-shrink-0 text-content-subtle"
                                       id="check-{{ forloop.counter }}"
                                       aria-hidden="true"></i>
                                    <code class="flex-1 truncate rounded-control border border-border bg-surface-muted px-3 py-2 font-mono text-caption text-content">{{ event }}</code>
                                    <c-button type="button"
                                              variant="secondary"
                                              size="sm"
                                              icon="copy"
                                              onclick="copyEvent('{{ event }}', {{ forloop.counter }})">
                                        Copy
                                    </c-button>
                                </div>
                            {% endfor %}
                        </div>
                    </c-checklist.item>

                    <c-checklist.item index="3"
                                      title="Choose the destination type"
                                      description="Pick “Webhook endpoint”, then continue." />

                    <c-checklist.item index="4" title="Paste the endpoint URL">
                        <c-code-block value="{{ webhook_url }}" class="mt-3" />
                    </c-checklist.item>

                    <c-checklist.item index="5" title="Copy the signing secret back here">
                        <p class="text-body text-content-muted">
                            Stripe shows it once the endpoint exists. It starts with
                            <code class="rounded bg-surface-muted px-1 font-mono">whsec_</code>.
                        </p>
                        <div class="mt-3">
                            <c-input name="webhook_secret"
                                     label="Signing secret"
                                     placeholder="whsec_…"
                                     help="We store this encrypted and use it to verify every incoming webhook."
                                     secret
                                     required />
                        </div>
                    </c-checklist.item>
                </c-checklist>

                <c-slot name="actions">
                    <c-button type="submit" icon="plug-connected">
                        {% if existing_integration %}
                            Update Stripe
                        {% else %}
                            Connect Stripe
                        {% endif %}
                    </c-button>
                </c-slot>
            </c-form>
        </c-card>

        <c-card title="Not the person with Stripe access?"
                description="Send these steps to whoever manages your Stripe account."
                icon="mail-forward">
            <c-form action="{% url 'core:email_setup_instructions' 'stripe' %}">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                    <c-input name="recipient_email"
                             type="email"
                             label="Their email address"
                             placeholder="colleague@yourcompany.com"
                             autocomplete="email"
                             required
                             class="flex-1" />
                    <c-button type="submit" variant="secondary" icon="send">
                        Send instructions
                    </c-button>
                </div>
            </c-form>
            <c-slot name="footer">
                They create the endpoint and send you back the signing secret to paste above.
            </c-slot>
        </c-card>

        <c-card title="What Stripe events become" icon="sparkles">
            <ul class="flex flex-col gap-2">
                <c-plan-card.feature>
                    A payment succeeds or fails, with the customer's history attached
                </c-plan-card.feature>
                <c-plan-card.feature>
                    A subscription starts, changes or cancels
                </c-plan-card.feature>
                <c-plan-card.feature>
                    A trial is about to end
                </c-plan-card.feature>
                <c-plan-card.feature>
                    A checkout completes
                </c-plan-card.feature>
            </ul>
        </c-card>
    </c-page>
{% endblock content %}

{% block extra_scripts %}
    <script>
        function copyEvent(text, index) {
            const check = document.getElementById('check-' + index);
            if (check) {
                check.classList.remove('text-content-subtle');
                check.classList.add('text-success-text');
            }
            NotipusUI.copyToClipboard(text);
        }
    </script>
{% endblock extra_scripts %}
