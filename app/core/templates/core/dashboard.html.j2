{% extends "core/base.html.j2" %}
{% load humanize %}

{% block title %}
    Dashboard - {{ organization.name }}
{% endblock title %}

{% block content %}
    <c-page width="wide"
            title="Welcome back{% if user.first_name %}, {{ user.first_name }}{% endif %}"
            subtitle="What's happening across {{ organization.name }}.">
        <c-slot name="actions">
            {% if organization.subscription_plan == "free" or organization.subscription_status == "trial" %}
                <c-button href="{% url 'core:upgrade_plan' %}" icon="trending-up">Change plan</c-button>
            {% endif %}
        </c-slot>

        {% if setup_progress and not setup_progress.complete %}
            <c-card title="Finish your setup"
                    description="{{ setup_progress.done_count }} of {{ setup_progress.total }} steps done"
                    icon="rocket">
                <c-progress :value="setup_progress.percent" label="Setup progress" class="mb-5" />
                <c-checklist>
                    {% for step in setup_progress.steps %}
                        {% if step.key == "slack" %}
                            <c-checklist.item :title="step.label"
                                              :done="step.done"
                                              index="{{ forloop.counter }}"
                                              description="Where your notifications land"
                                              href="{% url 'core:integrate_slack' %}" />
                        {% elif step.key == "source" %}
                            <c-checklist.item :title="step.label"
                                              :done="step.done"
                                              index="{{ forloop.counter }}"
                                              description="Stripe, Shopify or Chargify"
                                              href="{% url 'core:integrations' %}" />
                        {% elif step.key == "first_event" %}
                            <c-checklist.item :title="step.label"
                                              :done="step.done"
                                              index="{{ forloop.counter }}"
                                              description="Ticks itself the moment a webhook reaches us" />
                        {% else %}
                            {% comment %}account and workspace are already done by the
                            time anyone sees this list, so they need no instructions.{% endcomment %}
                            <c-checklist.item :title="step.label" :done="step.done" index="{{ forloop.counter }}" />
                        {% endif %}
                    {% endfor %}
                </c-checklist>
            </c-card>
        {% endif %}

        <c-card title="{{ organization.name }}"
                description="{{ organization.subscription_plan|title }} plan · created {{ organization.created_at|date:'M j, Y' }}"
                icon="building">
            <c-slot name="actions">
                {% if usage_percentage >= 90 %}
                    <c-badge tone="danger" dot>
                        Near the limit
                    </c-badge>
                {% elif usage_percentage >= 75 %}
                    <c-badge tone="warning" dot>
                        High usage
                    </c-badge>
                {% else %}
                    <c-badge tone="success" dot>
                        Healthy
                    </c-badge>
                {% endif %}
                <c-button href="{% url 'core:billing_dashboard' %}"
                          variant="secondary"
                          size="sm">Billing</c-button>
            </c-slot>

            <div class="flex flex-col gap-5">
                <div>
                    <div class="mb-2 flex items-baseline justify-between gap-2">
                        <span class="text-body font-medium text-content">Events this month</span>
                        <span class="text-body text-content-muted">
                            {{ rate_limit_info.current_usage|floatformat:0|intcomma }} of
                            {{ rate_limit_info.limit|floatformat:0|intcomma }}
                            ({{ usage_percentage|floatformat:1 }}%)
                        </span>
                    </div>
                    <c-progress :value="usage_percentage"
                                label="Monthly event usage"
                                tone="{% if usage_percentage >= 90 %}danger{% elif usage_percentage >= 75 %}warning{% else %}brand{% endif %}" />
                    <p class="mt-2 text-body text-content-subtle">
                        {% if organization.subscription_status == "trial" %}
                            {{ trial_days_remaining }} day{{ trial_days_remaining|pluralize }} left in your trial.
                        {% else %}
                            Resets {{ rate_limit_info.reset_time|date:"M j" }}.
                        {% endif %}
                    </p>
                </div>

                {% if usage_percentage >= 95 %}
                    <c-alert tone="danger" title="You're about to run out of events">
                        You've used {{ rate_limit_info.current_usage|floatformat:0|intcomma }} of
                        {{ rate_limit_info.limit|floatformat:0|intcomma }} events this month.
                        {% if pause_at %}
                            Delivery stops at {{ pause_at|intcomma }} events until your count resets{% if rate_limit_info.reset_time %} on {{ rate_limit_info.reset_time|date:"M j" }}{% endif %}.
                        {% endif %}
                        <c-slot name="actions">
                            <c-button href="{% url 'core:upgrade_plan' %}" size="sm">Raise the limit</c-button>
                        </c-slot>
                    </c-alert>
                {% elif usage_percentage >= 80 %}
                    <c-alert tone="warning" title="You're on track to hit the limit">
                        {{ rate_limit_info.current_usage|floatformat:0|intcomma }} of
                        {{ rate_limit_info.limit|floatformat:0|intcomma }} events used
                        {% if rate_limit_info.reset_time %}with the reset still to come on {{ rate_limit_info.reset_time|date:"M j" }}{% endif %}.
                        <c-slot name="actions">
                            <c-button href="{% url 'core:upgrade_plan' %}" size="sm" variant="secondary">See plans</c-button>
                        </c-slot>
                    </c-alert>
                {% endif %}
            </div>
        </c-card>

        <c-card title="Recent activity"
                description="{% if recent_activity %}The last {{ recent_activity|length }} event{{ recent_activity|length|pluralize }} we processed{% else %}Events appear here as they arrive{% endif %}"
                icon="bolt"
                flush>
            {% if recent_activity %}
                <ul class="flex flex-col gap-3 p-gutter">
                    {% for activity in recent_activity %}<c-activity-item :activity="activity" />{% endfor %}
                </ul>
            {% else %}
                <c-empty-state icon="bolt"
                               title="No events yet"
                               description="Connect a payment provider and the first order or payment shows up here within seconds.">
                    <c-slot name="actions">
                        <c-button href="{% url 'core:integrations' %}" icon="plug">Set up an integration</c-button>
                    </c-slot>
                </c-empty-state>
            {% endif %}
        </c-card>
    </c-page>
{% endblock content %}
