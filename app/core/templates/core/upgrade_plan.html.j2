{% extends "core/base.html.j2" %}
{% load humanize %}

{% block title %}
    Change plan - Notipus
{% endblock title %}

{% block content %}
    <c-page width="wide"
            back="{% url 'core:billing_dashboard' %}"
            back_label="Billing"
            title="Change plan"
            subtitle="Every plan includes all integrations. What changes is how many events a month you can send.">
        <c-alert tone="info" title="You're on {{ current_plan|title }}">
            {% if events_used %}
                You've used {{ events_used|intcomma }} of {{ events_limit|intcomma }} events this month{% if usage_percentage >= 80 and pause_at %}; delivery pauses at {{ pause_at|intcomma }}{% endif %}.
            {% else %}
                Changing plan takes effect immediately and your integrations keep running.
            {% endif %}
        </c-alert>

        {% if has_yearly_plans %}
            {% comment %}Yearly first: the lower per-month price anchors, matching the marketing site.{% endcomment %}
            <div class="flex justify-center">
                <c-segmented label="Billing interval">
                    <c-segmented.option value="yearly" selected>
                        Yearly
                    </c-segmented.option>
                    <c-segmented.option value="monthly">
                        Monthly
                    </c-segmented.option>
                </c-segmented>
            </div>
        {% endif %}

        <div class="grid gap-6 {% if plans|length == 2 %}mx-auto max-w-4xl md:grid-cols-2{% else %}md:grid-cols-2 lg:grid-cols-3{% endif %}">
            {% for plan in plans %}
                <c-plan-card :name="plan.name"
                             price="{% if plan.price_yearly %}${{ plan.price_yearly_per_month }}{% else %}${{ plan.price }}{% endif %}"
                             period="{% if plan.price_yearly %}/month{% else %}/{{ plan.interval }}{% endif %}"
                             description="{% if plan.recommended %}Built for growing teams{% elif plan.is_downgrade %}A lower tier than your current plan{% elif plan.id == 'basic' %}Enough to get going{% else %}For large organisations{% endif %}"
                             :featured="plan.recommended"
                             current="{% if plan.id == current_plan %}1{% endif %}">
                    <c-slot name="actions">
                        <c-button href="{% url 'core:checkout' plan_name=plan.id %}{% if plan.price_yearly %}?interval=yearly{% endif %}"
                                  variant="{% if plan.recommended %}primary{% else %}secondary{% endif %}"
                                  block
                                  class="checkout-link"
                                  data-checkout-base="{% url 'core:checkout' plan_name=plan.id %}">
                            {% if plan.is_downgrade %}
                                Move to {{ plan.name }}
                            {% else %}
                                Choose {{ plan.name }}
                            {% endif %}
                        </c-button>
                    </c-slot>
                    <c-slot name="features">
                        {% for feature in plan.features %}<c-plan-card.feature>{{ feature }}</c-plan-card.feature>{% endfor %}
                    </c-slot>
                    {% if plan.price_yearly %}
                        <p class="mt-3 text-body text-content-subtle"
                           data-interval-block="yearly">
                            ${{ plan.price_yearly }} billed annually{% if plan.yearly_savings %} · saves ${{ plan.yearly_savings }}{% endif %}
                        </p>
                        <p class="mt-3 hidden text-body text-content-subtle"
                           data-interval-block="monthly">${{ plan.price }} billed each month</p>
                    {% endif %}
                </c-plan-card>
            {% endfor %}
        </div>

        <c-card title="What changing plan does and doesn't do" icon="help-circle">
            <div class="flex flex-col gap-5">
                <div>
                    <h3 class="text-body font-semibold text-content">When am I charged?</h3>
                    <p class="mt-1 text-body text-content-muted">
                        Straight away, prorated for the rest of the current billing cycle. Your renewal date doesn't move.
                    </p>
                </div>
                <div>
                    <h3 class="text-body font-semibold text-content">Can I go back down?</h3>
                    <p class="mt-1 text-body text-content-muted">
                        Yes. Downgrades take effect at the end of the current cycle, so you keep what you paid for.
                    </p>
                </div>
                <div>
                    <h3 class="text-body font-semibold text-content">What happens to my integrations?</h3>
                    <p class="mt-1 text-body text-content-muted">
                        Nothing. Connections, channels and event settings all carry over untouched.
                    </p>
                </div>
            </div>
        </c-card>

        <p class="text-center text-body text-content-muted">
            Not sure which fits?
            <a href="mailto:sales@notipus.com"
               class="rounded-control font-medium text-brand-text underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2">
                Talk to us
            </a>
        </p>
    </c-page>
{% endblock content %}

{% block extra_scripts %}
    <script>
        (function() {
            const radios = Array.from(document.querySelectorAll("[data-segment]"));
            if (!radios.length) return;

            function select(interval, focus) {
                radios.forEach(function(btn) {
                    const on = btn.dataset.segment === interval;
                    btn.setAttribute("aria-checked", on ? "true" : "false");
                    btn.tabIndex = on ? 0 : -1;
                    btn.classList.toggle("bg-action", on);
                    btn.classList.toggle("text-content-inverse", on);
                    btn.classList.toggle("text-content-muted", !on);
                    if (on && focus) btn.focus();
                });
                document.querySelectorAll("[data-interval-block]").forEach(function(block) {
                    block.classList.toggle("hidden", block.dataset.intervalBlock !== interval);
                });
                document.querySelectorAll(".checkout-link[data-checkout-base]").forEach(function(link) {
                    link.href = link.dataset.checkoutBase + "?interval=" + interval;
                });
            }

            radios.forEach(function(btn, index) {
                btn.addEventListener("click", function() {
                    select(btn.dataset.segment, false);
                });
                btn.addEventListener("keydown", function(event) {
                    if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) return;
                    event.preventDefault();
                    const step = (event.key === "ArrowRight" || event.key === "ArrowDown") ? 1 : -1;
                    const next = radios[(index + step + radios.length) % radios.length];
                    select(next.dataset.segment, true);
                });
            });

            select("yearly", false);
        })();
    </script>
{% endblock extra_scripts %}
