{% extends "core/base.html.j2" %}

{% block title %}
    Connect Microsoft Teams - Notipus
{% endblock title %}

{% block content %}
    <c-page back="{% url 'core:integrations' %}"
            back_label="Integrations"
            title="Connect Microsoft Teams"
            subtitle="Notifications posted into a Teams channel by a workflow you create.">
        {% if existing_integration %}
            <c-alert tone="success" title="Microsoft Teams is connected">
                Re-enter a webhook URL below to point it at a different channel.
            </c-alert>
        {% endif %}

        <c-card title="Workflow webhook URL"
                description="Teams gives you this when you create the workflow."
                icon="link">
            <c-form>
                {% comment %}
                The stored webhook URL is never rendered back into this field. It is a
                bearer secret — anyone holding it can post to the channel — so updating
                means pasting it again.
                {% endcomment %}
                <c-input name="webhook_url"
                         type="url"
                         label="Webhook URL"
                         placeholder="https://prod-XX.westus.logic.azure.com:443/workflows/…"
                         help="Created with the Workflows app in Teams; the steps are below.{% if existing_integration %} Re-enter it to update the connection.{% endif %}"
                         autocomplete="off"
                         required />
                <c-slot name="actions">
                    <c-button type="submit" icon="plug-connected">
                        {% if existing_integration %}
                            Update connection
                        {% else %}
                            Connect Microsoft Teams
                        {% endif %}
                    </c-button>
                </c-slot>
            </c-form>
        </c-card>

        <c-card title="Creating the workflow" icon="list-check">
            <c-checklist>
                <c-checklist.item index="1"
                                  title="Open the Workflows app in Teams"
                                  description="It replaces the retiring Incoming Webhook connector." />
                <c-checklist.item index="2"
                                  title="Use the webhook template"
                                  description="Pick “Post to a channel when a webhook request is received”, then choose the team and channel." />
                <c-checklist.item index="3"
                                  title="Copy the HTTP POST URL"
                                  description="Teams shows it once the workflow is saved. Paste it above." />
                <c-checklist.item index="4"
                                  title="Send a test"
                                  description="Use send test on the integrations page to put a sample card in the channel." />
            </c-checklist>
            <c-slot name="footer">
                Microsoft's own guide:
                <a href="https://support.microsoft.com/en-us/office/create-incoming-webhooks-with-workflows-for-microsoft-teams-8ae491c7-0394-4861-ba59-055e33f75498"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="font-medium text-brand-text underline-offset-4 hover:underline">Create webhooks with Workflows for Microsoft Teams</a>.
            </c-slot>
        </c-card>

        <c-card title="What arrives in Teams" icon="sparkles">
            <ul class="flex flex-col gap-2">
                <c-plan-card.feature>
                    Payments and subscription changes as they happen
                </c-plan-card.feature>
                <c-plan-card.feature>
                    Adaptive Cards carrying customer and company context
                </c-plan-card.feature>
                <c-plan-card.feature>
                    Buttons through to the order or payment in Stripe or Shopify
                </c-plan-card.feature>
                <c-plan-card.feature>
                    Works alongside Slack and Telegram
                </c-plan-card.feature>
            </ul>
        </c-card>
    </c-page>
{% endblock content %}
