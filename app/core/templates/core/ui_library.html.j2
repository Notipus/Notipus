                    Neutral
                </c-badge>
                <c-badge tone="brand">
                    Brand
                </c-badge>
                <c-badge tone="success" icon="circle-check">
                    Connected
                </c-badge>
                <c-badge tone="warning" icon="clock">
                    No events yet
                </c-badge>
                <c-badge tone="danger" icon="circle-x">
                    Failed
                </c-badge>
                <c-badge tone="info" icon="antenna-bars-5">
                    Receiving
                </c-badge>
                <c-badge tone="success" dot>
                    With a dot
                </c-badge>
                <c-slot name="source">{% verbatim %}<c-badge tone="success" icon="circle-check">Connected</c-badge>{% endverbatim %}</c-slot>
            </c-spec>

            <c-spec name="c-alert" note="What happened, and what to do next.">
                <div class="flex w-full flex-col gap-3">
                    <c-alert tone="info" title="Neutral guidance">
                        Explains what a page does.
                    </c-alert>
                    <c-alert tone="success" title="Stripe is connected">
                        Events are arriving.
                    </c-alert>
                    <c-alert tone="warning" title="Trial ends Friday">
                        Add a payment method to keep notifications flowing.
                        <c-slot name="actions">
                            <c-button size="sm">
                                Add payment method
                            </c-button>
                        </c-slot>
                    </c-alert>
                    <c-alert tone="danger" title="Delivery has stopped">
                        You've used every event in this month's plan.
                    </c-alert>
                </div>
                <c-slot name="source">
                    {% verbatim %}
                        <c-alert tone="warning" title="Trial ends Friday">
                            Add a payment method to keep notifications flowing.
                            <c-slot name="actions">
                                <c-button size="sm">
                                    Add payment method
                                </c-button>
                            </c-slot>
                        </c-alert>
                    {% endverbatim %}
                </c-slot>
            </c-spec>

            <c-spec name="c-card" note="The container everything lives in.">
                <div class="grid w-full gap-4 md:grid-cols-2">
                    <c-card title="With a header"
                            description="And a description"
                            icon="chart-bar">
                        <c-slot name="actions">
                            <c-button size="sm" variant="secondary">
                                Action
                            </c-button>
                        </c-slot>
                        Body content sits here.
                        <c-slot name="footer">
