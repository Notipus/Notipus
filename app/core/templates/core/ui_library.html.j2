                            <c-slot name="features">
                                <c-plan-card.feature>
                                    100,000 events a month
                                </c-plan-card.feature>
                            </c-slot>
                        </c-plan-card>
                    {% endverbatim %}
                </c-slot>
            </c-spec>

            <c-spec name="c-segmented" note="Two or three views of the same content.">
                <c-segmented label="Example interval">
                    <c-segmented.option value="yearly" selected>
                        Yearly
                    </c-segmented.option>
                    <c-segmented.option value="monthly">
                        Monthly
                    </c-segmented.option>
                </c-segmented>
                <c-slot name="source">
                    {% verbatim %}
                        <c-segmented label="Billing interval">
                            <c-segmented.option value="yearly" selected>
                                Yearly
                            </c-segmented.option>
                            <c-segmented.option value="monthly">
                                Monthly
                            </c-segmented.option>
                        </c-segmented>
                    {% endverbatim %}
                </c-slot>
            </c-spec>

            <c-spec name="c-empty-state" note="An invitation to act, not an apology.">
                <div class="w-full rounded-control border border-border">
                    <c-empty-state icon="bolt"
                                   title="No events yet"
                                   description="Connect a payment provider and the first order shows up here within seconds.">
                        <c-slot name="actions">
                            <c-button icon="plug">
                                Set up an integration
                            </c-button>
                        </c-slot>
                    </c-empty-state>
                </div>
                <c-slot name="source">
                    {% verbatim %}
                        <c-empty-state icon="bolt"
                                       title="No events yet"
                                       description="Connect a provider and events land here within seconds.">
                            <c-slot name="actions">
                                <c-button icon="plug">
                                    Set up an integration
                                </c-button>
                            </c-slot>
                        </c-empty-state>
                    {% endverbatim %}
                </c-slot>
            </c-spec>

            <c-spec name="c-avatar / c-divider"
                    note="A person or company, and a rule between groups.">
                <c-avatar name="Ada Lovelace" size="sm" />
                <c-avatar name="Ada Lovelace" />
                <c-avatar name="Ada Lovelace" size="lg" />
                <div class="w-full">
                    <c-divider />
                </div>
                <div class="w-full">
                    <c-divider label="or" />
                </div>
                <c-slot name="source">
                    {% verbatim %}
                        <c-avatar name="{{ member.user.email }}" />
                        <c-divider label="or" />
                    {% endverbatim %}
                </c-slot>
            </c-spec>

            <c-spec name="Dialogs and toasts"
                    note="Driven by NotipusUI in app/static/js/ui.js.">
                <c-button variant="danger"
                          onclick="NotipusUI.confirmDelete('They lose access to this workspace immediately.', 'member')">
                    confirmDelete()
                </c-button>
                <c-button variant="secondary"
                          onclick="NotipusUI.confirmDisconnect('Slack', 'Notifications stop arriving. You can reconnect at any time.')">
                    confirmDisconnect()
                </c-button>
                <c-button variant="secondary"
                          onclick="NotipusUI.confirmAction('Make this the default card?', 'Future charges use this card.', 'Make default')">
                    confirmAction()
                </c-button>
                <c-button variant="secondary"
                          onclick="NotipusUI.toast('Notifications now go to #alerts', 'success')">
                    toast(success)
                </c-button>
                <c-button variant="secondary"
                          onclick="NotipusUI.toast('We could not save that channel.', 'error')">
                    toast(error)
                </c-button>
                <c-button variant="secondary"
                          onclick="NotipusUI.toast('Your trial ends on Friday.', 'warning')">
                    toast(warning)
                </c-button>
                <c-button variant="secondary"
                          onclick="NotipusUI.toast('Your next invoice is due on the 1st.', 'info')">
                    toast(info)
                </c-button>
                <c-button variant="secondary"
                          onclick="document.getElementById('demo-dialog').classList.remove('hidden')">
                    c-dialog
                </c-button>
                <c-slot name="source">
                    {% verbatim %}
                        <form onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Remove Ada?', variant: 'danger'})">
                        NotipusUI.toast('Notifications now go to #alerts', 'success');{% endverbatim %}</c-slot>
                </c-spec>

                <c-spec name="Icons" note="Tabler, via <c-icon> or the ti ti-* classes.">
                    {% for name in sample_icons %}
                        <span class="flex w-24 flex-col items-center gap-1 rounded-control border border-border p-2">
                            <c-icon :name="name" size="lg" />
                            <span class="w-full truncate text-center font-mono text-caption text-content-subtle">{{ name }}</span>
                        </span>
                    {% endfor %}
                    <c-slot name="source">
                        {% verbatim %}
                            <c-icon name="circle-check" tone="success" />
                            <c-icon name="alert-triangle" label="Warning" />
                        {% endverbatim %}
                    </c-slot>
                </c-spec>
            </div>
        </c-card>
    </c-page>

    <c-dialog id="demo-dialog"
              title="A page-owned dialog"
              description="Use this when the modal has real content: a form, a picker, a preview."
              icon="layout-board">
        <c-input name="demo_dialog_field" label="Channel" placeholder="#alerts" />
        <c-slot name="actions">
            <c-button onclick="document.getElementById('demo-dialog').classList.add('hidden')">
                Save
            </c-button>
            <c-button variant="secondary"
                      onclick="document.getElementById('demo-dialog').classList.add('hidden')">
                Cancel
            </c-button>
        </c-slot>
    </c-dialog>
{% endblock content %}
