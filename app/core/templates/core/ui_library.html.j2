{% extends "core/base.html.j2" %}

{% comment %}
The component library, served only when settings.UI_LIBRARY_ENABLED is on.

Everything here reads from app/core/design_tokens.py, so a token added there
appears on this page without anyone editing it. Component examples are hand
written — that is the point: they are how the library says a component should be
used, and they break loudly if a component's props change.
{% endcomment %}

{% block title %}
    Component library - Notipus
{% endblock title %}

{% block content %}
    <c-page width="wide"
            title="Component library"
            subtitle="Every design token and every component in one place. Development only — this page does not exist in production.">
        <c-slot name="actions">
            {% if contrast_failures %}
                <c-badge tone="danger" icon="alert-triangle">
                    {{ contrast_failures|length }} contrast failures
                </c-badge>
            {% else %}
                <c-badge tone="success" icon="circle-check">
                    {{ contrast_rules|length }} pairings pass WCAG AA
                </c-badge>
            {% endif %}
        </c-slot>

        {% if contrast_failures %}
            <c-alert tone="danger" title="Some token pairings miss their WCAG threshold">
                <ul class="ml-4 list-disc space-y-1">
                    {% for rule in contrast_failures %}
                        <li>
                            <code class="font-mono">{{ rule.foreground }}</code> on
                            <code class="font-mono">{{ rule.background }}</code> is
                            {{ rule.ratio|floatformat:2 }}:1, needs {{ rule.minimum }}:1 — {{ rule.where }}
                        </li>
                    {% endfor %}
                </ul>
            </c-alert>
        {% endif %}

        {# ---------------------------------------------------------------- #}
        {# Tokens                                                           #}
        {# ---------------------------------------------------------------- #}
        <c-card title="Design tokens"
                description="Generated from app/core/design_tokens.py into src/css/tokens.css."
                icon="palette">
            <div class="flex flex-col gap-8">
                {% for group in token_groups %}
                    <section>
                        <h3 class="text-heading font-semibold text-content">{{ group.title }}</h3>
                        <p class="mt-1 max-w-3xl text-body text-content-muted">{{ group.description }}</p>
                        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                            {% for token in group.tokens %}
                                {% comment %}
                                min-w-0 so the grid track can shrink. A grid item
                                defaults to min-width:auto, and the truncated
                                value below is whitespace-nowrap, so the font
                                stacks under Typefaces sized their cell to 765px
                                inside a 500px viewport — clipped by the card's
                                overflow-hidden rather than ever truncating.
                                {% endcomment %}
                                <div class="flex min-w-0 items-start gap-3 rounded-control border border-border p-3">
                                    {% comment %}block, not just h-9 w-9: an inline span ignores width.{% endcomment %}
                                    {% if group.is_color %}
                                        <span class="mt-0.5 block h-9 w-9 flex-shrink-0 rounded-control border border-border"
                                              style="background: {{ token.value }}"
                                              aria-hidden="true"></span>
                                    {% else %}
                                        <span class="mt-0.5 flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-control border border-border bg-surface-muted"
                                              aria-hidden="true">
                                            <i class="ti ti-ruler-measure text-content-subtle"></i>
                                        </span>
                                    {% endif %}
                                    <div class="min-w-0">
                                        <p class="truncate font-mono text-caption font-semibold text-content">{{ group.namespace }}-{{ token.name }}</p>
                                        <p class="truncate font-mono text-caption text-content-subtle">{{ token.value }}</p>
                                        <p class="mt-1 text-body text-content-muted">{{ token.usage }}</p>
                                        {% if token.graphic_only %}
                                            <p class="mt-1">
                                                <c-badge tone="warning" icon="alert-triangle">
                                                    Graphic only — never behind text
                                                </c-badge>
                                            </p>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}
            </div>
        </c-card>

        {# ---------------------------------------------------------------- #}
        {# Contrast                                                         #}
        {# ---------------------------------------------------------------- #}
        <c-card title="Measured contrast"
                description="Every foreground/background pairing the components actually render, checked against the thresholds Lighthouse audits."
                icon="contrast"
                flush>
            <c-table caption="Measured contrast ratios for every declared token pairing">
                <c-slot name="head">
                    <c-table.column>
                        Foreground
                    </c-table.column>
                    <c-table.column>
                        Background
                    </c-table.column>
                    <c-table.column>
                        Where
                    </c-table.column>
                    <c-table.column align="right">
                        Ratio
                    </c-table.column>
                    <c-table.column align="right">
                        Needs
                    </c-table.column>
                    <c-table.column>
                        Result
                    </c-table.column>
                </c-slot>
                {% for rule in contrast_rules %}
                    <tr>
                        <c-table.cell class="font-mono">
                            {{ rule.foreground }}
                        </c-table.cell>
                        <c-table.cell class="font-mono">
                            {{ rule.background }}
                        </c-table.cell>
                        <c-table.cell muted>
                            {{ rule.where }}
                        </c-table.cell>
                        <c-table.cell align="right" class="font-mono">
                            {{ rule.ratio|floatformat:2 }}
                        </c-table.cell>
                        <c-table.cell align="right" class="font-mono">
                            {{ rule.minimum }}
                        </c-table.cell>
                        <c-table.cell>
                            {% if rule.passes %}
                                <c-badge tone="success" icon="circle-check">
                                    {{ rule.kind }}
                                </c-badge>
                            {% else %}
                                <c-badge tone="danger" icon="circle-x">
                                    fails
                                </c-badge>
                            {% endif %}
                        </c-table.cell>
                    </tr>
                {% endfor %}
            </c-table>
        </c-card>

        {# ---------------------------------------------------------------- #}
        {# Type                                                             #}
        {# ---------------------------------------------------------------- #}
        <c-card title="Type scale"
                description="Reach for the role, not the size."
                icon="typography">
            <div class="flex flex-col gap-4">
                <p class="text-display font-bold text-content">Display — headlines and empty states</p>
                <p class="text-title font-bold text-content">Title — the single h1 on a page</p>
                <p class="text-heading font-semibold text-content">Heading — card and section titles</p>
                <p class="text-lead text-content-muted">Lead — page subtitles and intro copy</p>
                <p class="text-body text-content">Body — the default for copy and controls</p>
                <p class="text-caption text-content-subtle">Caption — badges, table headers, metadata</p>
                <p class="font-mono text-body text-content">Mono — webhook URLs, secrets, ids</p>
            </div>
        </c-card>

        {# ---------------------------------------------------------------- #}
        {# Components                                                       #}
        {# ---------------------------------------------------------------- #}
        <c-card title="Components"
                description="Each example is live markup, with its source underneath."
                icon="components">
            <div class="flex flex-col gap-10">

                <c-spec name="c-button" note="The only clickable affordance.">
                    <c-button>
                        Primary
                    </c-button>
                    <c-button variant="secondary">
                        Secondary
                    </c-button>
                    <c-button variant="ghost">
                        Ghost
                    </c-button>
                    <c-button variant="danger">
                        Danger
                    </c-button>
                    <c-button variant="link">
                        Link
                    </c-button>
                    <c-button variant="link-danger">
                        Link danger
                    </c-button>
                    <c-button variant="link-muted">
                        Link muted
                    </c-button>
                    <c-button icon="plug-connected">
                        With icon
                    </c-button>
                    <c-button icon="chevron-right" trailing>
                        Trailing icon
                    </c-button>
                    <c-button size="sm">
                        Small
                    </c-button>
                    <c-button size="lg">
                        Large
                    </c-button>
                    <c-button loading>
                        Loading
                    </c-button>
                    <c-button disabled>
                        Disabled
                    </c-button>
                    <c-button href="#c-button" variant="secondary">
                        As a link
                    </c-button>
                    <c-slot name="source">{% verbatim %}<c-button variant="danger" icon="trash">Remove member</c-button>
                        <c-button href="/billing/" variant="secondary" size="sm">Billing</c-button>{% endverbatim %}</c-slot>
            </c-spec>

            <c-spec name="c-badge" note="States a fact. Never clickable.">
