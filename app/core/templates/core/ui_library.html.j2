                        </c-slot>
                    </c-card>
                    <c-card>
                        Just a body, no header.
                    </c-card>
                </div>
                <c-slot name="source">
                    {% verbatim %}
                        <c-card title="Monthly usage"
                                description="Events this month"
                                icon="chart-bar">
                            <c-slot name="actions">
                                <c-button size="sm" variant="secondary">
                                    Details
                                </c-button>
                            </c-slot>
                            …
                            <c-slot name="footer">
                                Resets on the 1st.
                            </c-slot>
                        </c-card>
                    {% endverbatim %}
                </c-slot>
            </c-spec>

            <c-spec name="c-icon-tile" note="What a section is about.">
