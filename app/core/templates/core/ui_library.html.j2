                        <c-icon-tile name="rocket" tone="brand" size="lg" />
                    {% endverbatim %}
                </c-slot>
            </c-spec>

            <c-spec name="c-provider-logo"
                    note="A third party's own mark, in its own colours.">
                <c-provider-logo provider="shopify" label="Shopify" />
                <c-provider-logo provider="stripe" label="Stripe" />
                <c-provider-logo provider="slack" label="Slack" />
                <c-provider-logo provider="telegram" label="Telegram" />
                <c-provider-logo provider="teams" label="Microsoft Teams" />
                <c-provider-logo provider="hunter" label="Hunter.io" />
                <c-provider-logo provider="chargify" label="Chargify" />
                <c-provider-logo provider="unknown" label="Unknown provider" />
                <c-slot name="source">
                    {% verbatim %}
                        <c-provider-logo provider="stripe" label="Stripe" />
                    {% endverbatim %}
                </c-slot>
            </c-spec>

            <c-spec name="Form controls"
                    note="Label, control, help and error, wired together.">
                <div class="grid w-full gap-4 md:grid-cols-2">
                    <c-input name="demo_name"
                             label="Workspace name"
                             value="Acme Inc"
                             help="Shown throughout Notipus." />
                    <c-input name="demo_email"
                             type="email"
                             label="Email address"
                             placeholder="you@company.com"
                             error="Enter an address we can actually reach." />
                    <c-input name="demo_secret"
                             label="Signing secret"
                             placeholder="whsec_…"
                             help="Never rendered back into the page."
                             secret />
                    <c-select name="demo_role" label="Role" help="What they can change.">
                        <option>Member</option>
                        <option>Admin</option>
                    </c-select>
                    <c-textarea name="demo_notes"
                                label="Notes"
                                placeholder="Anything worth remembering"
                                rows="3" />
                    <div class="flex flex-col gap-3">
                        <c-checkbox name="demo_events"
                                    label="Order paid"
                                    help="Fires when a customer completes checkout."
                                    checked />
                        <c-checkbox name="demo_events_2" label="Order refunded" />
                    </div>
                    <c-readonly label="Current plan" help="Changed from Billing.">
                        Pro
                    </c-readonly>
                    <c-code-block label="Webhook URL"
                                  value="https://notipus.com/webhook/stripe/0f8a3c1e/" />
                </div>
                <c-slot name="source">
                    {% verbatim %}
                        <c-input name="webhook_secret"
                                 label="Signing secret"
                                 placeholder="whsec_…"
                                 secret
                                 required />
                        <c-select name="role" label="Role">
                            <option>Member</option>
                        </c-select>
                        <c-code-block label="Workspace ID" value="{{ workspace.uuid }}" />
                    {% endverbatim %}
                </c-slot>
            </c-spec>

            <c-spec name="c-progress" note="How far through something the workspace is.">
                <div class="flex w-full flex-col gap-3">
                    <c-progress value="35" label="Brand tone" />
                    <c-progress value="62" tone="success" label="Success tone" />
                    <c-progress value="81" tone="warning" label="Warning tone" />
                    <c-progress value="96" tone="danger" label="Danger tone" />
                    <c-progress value="50" size="sm" label="Small" />
                </div>
                <c-slot name="source">
                    {% verbatim %}
                        <c-progress value="81" tone="warning" label="Monthly event usage" />
