                <c-icon-tile name="circle-check" tone="success" />
                <c-icon-tile name="clock" tone="warning" />
                <c-icon-tile name="alert-triangle" tone="danger" />
                <c-icon-tile name="info-circle" tone="info" />
                <c-icon-tile name="settings" tone="neutral" />
                <c-icon-tile name="rocket" size="sm" />
                <c-icon-tile name="rocket" size="lg" />
                <c-slot name="source">
