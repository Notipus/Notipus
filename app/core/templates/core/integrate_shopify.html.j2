{% extends "core/base.html.j2" %}

{% block title %}
    Connect Shopify - {{ organization.name }}
{% endblock title %}

{% block content %}
    {% comment %}Flash messages render once, in base.html.j2.{% endcomment %}
    <c-page width="narrow"
            back="{% url 'core:integrations' %}"
            back_label="Integrations"
            title="Connect Shopify"
            subtitle="Orders and customers from your store, the moment they happen.">
        {% if integration %}
            <c-card title="Connection" icon="plug-connected">
                <c-slot name="actions">
                    {% if integration.is_webhook_verified %}
                        <c-badge tone="success" icon="circle-check">
                            Connected
                        </c-badge>
                    {% else %}
                        <c-badge tone="warning" icon="clock">
                            No events yet
                        </c-badge>
                    {% endif %}
                </c-slot>

                <c-definition>
                    <c-definition.row label="Store">
                        <a href="https://{{ integration.integration_settings.shop_domain }}/admin"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="inline-flex items-center gap-1 rounded-control font-medium text-brand-text underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2">
                            {{ integration.integration_settings.shop_domain }}
                            <i class="ti ti-external-link" aria-hidden="true"></i>
                        </a>
                    </c-definition.row>
                </c-definition>
            </c-card>

            <c-card title="Events to send"
                    description="Only what you tick reaches your notification channels."
                    icon="checklist">
                <c-form action="{% url 'core:update_shopify_events' %}">
                    <div class="flex flex-col gap-3">
                        {% for key, category in event_categories.items %}
                            <c-checkbox name="event_categories"
                                        id="event-{{ key }}"
                                        :value="key"
                                        :label="category.label"
                                        :help="category.description"
                                        checked="{% if key in enabled_categories %}1{% endif %}"
                                        class="rounded-control bg-surface-muted p-3" />
                        {% endfor %}
                    </div>
                    <c-slot name="actions">
                        <c-button type="submit" variant="secondary" icon="refresh">
                            Update events
                        </c-button>
                    </c-slot>
                </c-form>
            </c-card>

            <c-card title="Disconnect"
                    description="Removes the webhooks from your store."
                    icon="unlink"
                    tone="danger">
                <form method="post"
                      action="{% url 'core:disconnect_shopify' %}"
                      onsubmit="return NotipusUI.confirmSubmit(this, {title: 'Disconnect Shopify?', message: 'Order notifications stop and the webhook subscriptions are removed from your store.', variant: 'warning', confirmText: 'Disconnect', cancelText: 'Keep connected'})">
                    {% csrf_token %}
                    <c-button type="submit" variant="danger" icon="unlink">
                        Disconnect Shopify
                    </c-button>
                </form>
            </c-card>
        {% elif not shopify_configured %}
            <c-alert tone="warning" title="Shopify isn't set up on this deployment">
                The Shopify app credentials are missing, so the connection can't be started. Get in touch and we'll
                sort it out.
            </c-alert>
        {% else %}
            <c-card title="Your store"
                    description="We'll send you to Shopify to authorise the connection."
                    icon="building-store">
                <c-form action="{% url 'core:shopify_connect' %}">
                    <c-input name="shop_url"
                             label="Store URL"
                             placeholder="mystore or mystore.myshopify.com"
                             help="Using a custom domain? We need the myshopify.com one, from Shopify admin → Settings → Domains."
                             required />

                    <fieldset class="min-w-0">
                        <legend class="mb-1.5 text-body font-medium text-content">Events to send</legend>
                        <p class="mb-3 text-body text-content-muted">You can change this later.</p>
                        <div class="flex flex-col gap-3">
                            {% for key, category in event_categories.items %}
                                <c-checkbox name="event_categories"
                                            id="event-{{ key }}"
                                            :value="key"
                                            :label="category.label"
                                            :help="category.description"
                                            :checked="category.default"
                                            class="rounded-control bg-surface-muted p-3" />
                            {% endfor %}
                        </div>
                    </fieldset>

                    <c-slot name="actions">
                        <c-button type="submit" icon="plug-connected" block>
                            Continue to Shopify
                        </c-button>
                    </c-slot>
                </c-form>
            </c-card>

            <c-card title="What connecting does" icon="sparkles">
                <div class="grid gap-5 sm:grid-cols-3">
                    <c-feature layout="stack"
                               icon="bolt"
                               title="Orders in seconds"
                               description="Each order arrives in your channel as it is placed." />
                    <c-feature layout="stack"
                               icon="wand"
                               title="Webhooks set up for you"
                               description="No endpoint URLs to paste anywhere." />
                    <c-feature layout="stack"
                               icon="lock"
                               title="Read access only"
                               description="Orders and customers, plus permission to create webhooks." />
                </div>
                <c-slot name="footer">
                    You can revoke our access at any time from your Shopify admin.
                </c-slot>
            </c-card>
        {% endif %}
    </c-page>
{% endblock content %}
