{% extends "core/base.html.j2" %}

{% block title %}
    Welcome to Notipus
{% endblock title %}

{% block content %}
    <c-page width="narrow">
        <c-card>
            <div class="flex flex-col items-center text-center">
                <c-icon-tile name="check" tone="success" size="lg" />
                <h1 class="mt-4 text-title font-bold text-content">Your workspace is ready</h1>
                <p class="mt-2 text-lead text-content-muted">Three steps and your first notification lands in Slack.</p>
            </div>

            <c-divider class="my-6" />

            <c-checklist>
                <c-checklist.item index="1"
                                  title="Connect Slack"
                                  description="Choose where notifications are delivered."
                                  href="{% url 'core:integrate_slack' %}" />
                <c-checklist.item index="2"
                                  title="Connect a payment provider"
                                  description="Stripe, Shopify or Chargify — this is where events come from."
                                  href="{% url 'core:integrations' %}" />
                <c-checklist.item index="3"
                                  title="Choose your events"
                                  description="Pick which payments and orders are worth interrupting someone for." />
            </c-checklist>

            <div class="mt-6 flex flex-col gap-2 sm:flex-row">
                <c-button href="{% url 'core:integrations' %}" icon="plug" block>Start with integrations</c-button>
                <c-button href="{% url 'core:dashboard' %}" variant="secondary" block>Go to dashboard</c-button>
            </div>
        </c-card>
    </c-page>
{% endblock content %}
