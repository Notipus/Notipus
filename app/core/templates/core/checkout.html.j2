{% extends "core/base.html.j2" %}

{% block title %}
    Checkout - {{ plan.name }} - Notipus
{% endblock title %}

{% block content %}
    <c-page back="{% url 'core:upgrade_plan' %}"
            back_label="Plans"
            title="Checkout"
            subtitle="Confirm what you're subscribing to, then pay through Stripe.">
        <div class="grid gap-stack lg:grid-cols-2">
            <c-card title="Order summary" icon="receipt-2">
                <div class="rounded-control border border-border p-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <p class="text-heading font-semibold text-content">{{ plan.name }}</p>
                            <p class="text-body text-content-muted">Monthly subscription</p>
                        </div>
                        <div class="text-right">
                            <p class="text-title font-bold text-content">${{ plan.price }}</p>
                            <p class="text-body text-content-muted">per month</p>
                        </div>
                    </div>
                    <div class="mt-4 border-t border-border pt-4">
                        <p class="text-caption font-semibold uppercase tracking-wide text-content-muted">What's included</p>
                        <ul class="mt-2 flex flex-col gap-2">
                            {% if plan_name == "basic" %}
                                <c-plan-card.feature>
                                    Up to 10,000 events a month
                                </c-plan-card.feature>
                                <c-plan-card.feature>
                                    Every integration
                                </c-plan-card.feature>
                            {% elif plan_name == "pro" %}
                                <c-plan-card.feature>
                                    Up to 100,000 events a month
                                </c-plan-card.feature>
                                <c-plan-card.feature>
                                    Every integration
                                </c-plan-card.feature>
                                <c-plan-card.feature>
                                    Priority support
                                </c-plan-card.feature>
                            {% elif plan_name == "enterprise" %}
                                <c-plan-card.feature>
                                    1,000,000 events a month
                                </c-plan-card.feature>
                                <c-plan-card.feature>
                                    Custom integrations
                                </c-plan-card.feature>
                                <c-plan-card.feature>
                                    A named support contact
                                </c-plan-card.feature>
                            {% endif %}
                        </ul>
                    </div>
                </div>

                <c-definition class="mt-5">
                    <c-definition.row label="Subtotal" value="${{ plan.price }}.00" />
                    <c-definition.row label="Tax" value="$0.00" />
                    <c-definition.row label="Total due today" value="${{ plan.price }}.00" />
                </c-definition>

                <c-slot name="footer">
                    Billed monthly to {{ organization.name }}{% if organization.shop_domain %} ({{ organization.shop_domain }}){% endif %}.
                    Cancel any time from Billing.
                </c-slot>
            </c-card>

            <c-card title="Payment" icon="credit-card">
                <c-alert tone="info" title="Stripe collects your card details">
                    Your card never touches our servers. We store the brand, the last four digits and the expiry date so
                    you can recognise it later.
                </c-alert>

                <div class="mt-5">
                    <c-button id="checkout-submit"
                              block
                              size="lg"
                              icon="lock"
                              onclick="initiateStripeCheckout()">
                        Pay ${{ plan.price }} and subscribe
                    </c-button>
                </div>

                <p class="mt-4 text-body text-content-subtle">
                    Your subscription renews each month until you cancel it. Cancelling takes effect at the end of the
                    cycle you've already paid for.
                </p>
            </c-card>
        </div>

        <c-card title="Before you pay" icon="help-circle">
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <h3 class="text-body font-semibold text-content">When am I charged?</h3>
                    <p class="mt-1 text-body text-content-muted">As soon as checkout completes, then on the same date each month.</p>
                </div>
                <div>
                    <h3 class="text-body font-semibold text-content">Can I cancel?</h3>
                    <p class="mt-1 text-body text-content-muted">Any time, from Billing. There's no cancellation fee.</p>
                </div>
                <div>
                    <h3 class="text-body font-semibold text-content">Which cards work?</h3>
                    <p class="mt-1 text-body text-content-muted">Visa, Mastercard and American Express, through Stripe.</p>
                </div>
                <div>
                    <h3 class="text-body font-semibold text-content">Something looks wrong?</h3>
                    <p class="mt-1 text-body text-content-muted">
                        Email <a href="mailto:billing@notipus.com"
    class="font-medium text-brand-text underline-offset-4 hover:underline">billing@notipus.com</a>
                        before paying and we'll sort it out.
                    </p>
                </div>
            </div>
        </c-card>
    </c-page>
{% endblock content %}

{% block extra_scripts %}
    <script>
        function initiateStripeCheckout() {
            // Placeholder until the Stripe Checkout session is created server-side.
            const button = document.getElementById('checkout-submit');
            button.disabled = true;
            NotipusUI.toast('Taking you to Stripe…', 'info');
            setTimeout(function() {
                window.location.href = "{% url 'core:checkout_success' %}";
            }, 1500);
        }
    </script>
{% endblock extra_scripts %}
