{% extends "core/base.html.j2" %}

{% block title %}
    Workspace settings - {{ workspace.name }}
{% endblock title %}

{% block content %}
    <c-page width="narrow"
            back="{% url 'core:dashboard' %}"
            back_label="Dashboard"
            title="Workspace settings"
            subtitle="Your workspace's name, domain and identifiers.">
        <c-card title="Basic information"
                description="Used across Notipus and in the notifications you send."
                icon="building">
            <c-form>
                <c-input name="name"
                         label="Workspace name"
                         :value="workspace.name"
                         help="Shown throughout Notipus."
                         required />
                <c-input name="shop_domain"
                         label="Business domain"
                         value="{{ workspace.shop_domain|default_if_none:'' }}"
                         placeholder="yourbusiness.com"
                         help="Your main website. Optional." />
                <c-slot name="actions">
                    <c-button type="submit">
                        Save changes
                    </c-button>
                </c-slot>
            </c-form>
        </c-card>

        <c-card title="Plan and identifiers"
                description="Read-only details of this workspace."
                icon="id-badge">
            <div class="flex flex-col gap-5">
                <c-readonly label="Current plan">
                    <c-badge tone="success">
                        {{ workspace.subscription_plan|title }}
                    </c-badge>
                    {% if workspace.is_trial %}
                        <span class="ml-2 text-content-muted">Trial ends {{ workspace.trial_end_date|date:"M j, Y" }}</span>
                    {% endif %}
                </c-readonly>
                <c-code-block label="Workspace ID" value="{{ workspace.uuid }}" />
            </div>
        </c-card>

        <c-card title="Where to next" icon="route" flush>
            <div class="flex flex-col gap-3 p-gutter">
                <c-action-row href="{% url 'core:members_list' %}"
                              icon="users"
                              title="Members"
                              description="Invite people and set what they can change." />
                <c-action-row href="{% url 'core:integrations' %}"
                              icon="plug"
                              title="Integrations"
                              description="Connect Slack, Stripe, Shopify and the rest." />
                <c-action-row href="{% url 'core:billing_dashboard' %}"
                              icon="credit-card"
                              title="Billing"
                              description="Usage, invoices and payment methods." />
                <c-action-row href="{% url 'core:upgrade_plan' %}"
                              icon="trending-up"
                              tone="brand"
                              title="Change plan"
                              description="More events a month and more seats." />
            </div>
        </c-card>
    </c-page>
{% endblock content %}
