{% extends "core/base.html.j2" %}

{% block title %}
    Server error - Notipus
{% endblock title %}

{% block content %}
    <c-page width="narrow">
        <c-card>
            <div class="flex flex-col items-center px-4 py-12 text-center">
                <c-icon-tile name="alert-triangle" tone="danger" size="lg" />
                <p class="mt-4 font-mono text-caption uppercase tracking-widest text-content-subtle">Error 500</p>
                <h1 class="mt-1 text-title font-bold text-content">Server error</h1>
                <p class="mt-2 max-w-md text-body text-content-muted">
                    Something broke on our side and we've been told about it automatically. Reloading often works —
                    and your webhooks keep being received either way.
                </p>
                <div class="mt-6 flex flex-wrap justify-center gap-2">
                    <c-button icon="refresh" onclick="window.location.reload()">
                        Reload the page
                    </c-button>
                    <c-button href="{% url 'core:dashboard' %}" variant="secondary">Go to dashboard</c-button>
                </div>
            </div>
        </c-card>
    </c-page>
{% endblock content %}
